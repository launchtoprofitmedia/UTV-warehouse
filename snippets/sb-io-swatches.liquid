        'gray': '#808080',
        'grey': '#808080',
        'silver': '#C0C0C0',
        'charcoal': '#36454F',
        'slate': '#708090',
        'ivory': '#FFFFF0',
        'cream': '#FFFDD0',
        'off-white': '#FAF9F6',
        'bone': '#E3DAC9',
        
        // Metallics
        'rose gold': '#B76E79',
        'bronze': '#CD7F32',
        'copper': '#B87333',
        'champagne': '#F7E7CE',
        'pewter': '#8F8F8F',
        
        // Other common
        'spice n easy':'#a25033',
        'mlady - matte mauve': '#000',
        'heather grey': '#9AA297',
        'heather gray': '#9AA297',
        'oatmeal': '#D4C4A8',
        'sand': '#C2B280',
        'khaki': '#C3B091',
        'stone': '#928E85',
        'ash': '#B2BEB5',
        'graphite': '#383838',
        'tube': '#F5F5DC',
        'twist': '#2F2F2F'
      };

      function parseMap(id) {
        var el = document.getElementById(id);
        if (!el) return {};
        try { return JSON.parse(el.textContent || "{}"); } catch (e) { return {}; }
      }

      /**
       * Normalize string for matching: lowercase, strip price suffixes, 
       * remove ALL apostrophe/quote variants (straight, curly, backtick).
       * This matches the Liquid-side normalization applied to metaobject keys.
       */
      function norm(str) {
        return String(str || "").trim().toLowerCase()
          // Remove price suffix like "(+CA$5.00)" or "(+$5.00)"
          .replace(/\s*\([^)]*\)\s*$/, '')
          // Remove ALL apostrophe and quote variants:
          // ' (straight apostrophe U+0027)
          // ' (right single quote U+2019)
          // ' (left single quote U+2018)
          // ` (backtick U+0060)
          // " (straight double quote U+0022)
          // " (left double quote U+201C)
          // " (right double quote U+201D)
          .replace(/['''`""\u2018\u2019\u201C\u201D]/g, '')
          .trim();
      }

      function escapeHtml(str) {
        return String(str)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      // Get default color for an option value
      function getDefaultColor(val) {
        var key = norm(val);
        if (defaultColors[key]) return defaultColors[key];
        return null;
      }

      // Hide the app's required dropdowns once swatches are rendering the same properties.
      // The app also injects its own property inputs with the default dropdown values.
      // Those come later in the form and would override the swatch selection on submit.
      function replaceAppDropdowns() {
        var root = document.querySelector('[data-sb-io]');
        var form = root && root.closest('form');
        if (form) {
          form.querySelectorAll('.simple-bundles-infinite-option-prop').forEach(function(input) {
            input.disabled = true;
          });
        }
        var box = document.getElementById('simple-bundles-io-options');
        if (!box || box.getAttribute('data-sb-io-replaced') === 'true') return;
        box.querySelectorAll('select').forEach(function(sel) {
          sel.removeAttribute('required');
          sel.disabled = true;
        });
        box.setAttribute('data-sb-io-replaced', 'true');
      }

      // One request per child product. Many swatches share a handle, so waiters share that request.
      var productCache = {};
      var productWaiters = {};

      function sizedImage(src) {
        if (!src) return null;
        if (src.indexOf('//') === 0) src = 'https:' + src;
        return src.replace(/(\.[a-zA-Z]+)(\?.*)?$/, '_120x$1$2');
      }

      function fetchProduct(handle, callback) {
        if (Object.prototype.hasOwnProperty.call(productCache, handle)) {
          callback(productCache[handle]);
          return;
        }
        if (productWaiters[handle]) {
          productWaiters[handle].push(callback);
          return;
        }
        productWaiters[handle] = [callback];
        fetch('/products/' + handle + '.js')
          .then(function(res) { return res.json(); })
          .then(function(product) {
            productCache[handle] = product;
            var waiters = productWaiters[handle] || [];
            delete productWaiters[handle];
            waiters.forEach(function(fn) { fn(product); });
          })
          .catch(function() {
            productCache[handle] = null;
            var waiters = productWaiters[handle] || [];
            delete productWaiters[handle];
            waiters.forEach(function(fn) { fn(null); });
          });
      }

      function variantImageUrl(product, variantId) {
        if (!product) return null;
        if (!product._sbImages) {
          product._sbImages = {};
          (product.variants || []).forEach(function(v) {
            var src = v.featured_image && (v.featured_image.src || v.featured_image);
            product._sbImages[String(v.id)] = sizedImage(src || product.featured_image);
          });
        }
        return product._sbImages[String(variantId)] || sizedImage(product.featured_image);
      }

      function revealSwatches(list) {
        if (!list) return;
        var imgs = list.querySelectorAll('img');
        var pending = imgs.length;
        function done() {
          pending -= 1;
          if (pending <= 0) list.setAttribute('data-sb-io-ready', 'true');
        }
        if (!pending) {
          list.setAttribute('data-sb-io-ready', 'true');
          return;
        }
        imgs.forEach(function(img) {
          if (img.complete) done();
          else {
            img.addEventListener('load', done);
            img.addEventListener('error', done);
          }
        });
      }

      // Get currently selected variant ID
      function getSelectedVariantId() {
        // Try multiple methods to find the variant ID
        
        // Method 1: Check URL parameter
        var url = new URL(window.location.href);
        var urlVariant = url.searchParams.get('variant');
        if (urlVariant) return String(urlVariant);
        
        // Method 2: Look for hidden input or select with name="id"
        var idField = document.querySelector('form[action*="/cart/add"] [name="id"]');
        if (idField && idField.value) return String(idField.value);
        
        // Method 3: Look for product form wrapper
        var wrapper = document.getElementById('product-form-' + productId);
        if (wrapper) {
          var form = wrapper.querySelector('form[action*="/cart/add"]');
          if (form) {
            var field = form.querySelector('[name="id"]');
            if (field && field.value) return String(field.value);
          }
        }
        
        return null;
      }

      // Build product handle map from bundled_variants data
      function buildHandleMap(bundledVariants) {
        var handleMap = {};
        if (!bundledVariants || !Array.isArray(bundledVariants)) return handleMap;
        
        bundledVariants.forEach(function(bv) {
          if (bv.variant_options && Array.isArray(bv.variant_options)) {
            bv.variant_options.forEach(function(vo) {
              var optVal = norm(vo.value);
              if (optVal && bv.handle) {
                handleMap[optVal] = {
                  handle: bv.handle,
                  variantId: bv.variant_id,
                  label: bv.variant_title || vo.value
                };
              }
            });
          }
        });
        
        return handleMap;
      }

      // Render swatches for a specific variant's options
      function renderSwatches(container, options, bundledVariants) {
        var groupsContainer = container.querySelector('[data-sb-io-groups]');
        if (!groupsContainer) return;
        
        var swatchMap = parseMap('sb-swatch-map');
        var handleMap = buildHandleMap(bundledVariants);
        
        // Clear existing groups
        groupsContainer.innerHTML = '';
        
        if (!options || options.length === 0) {
          container.style.display = 'none';
          return;
        }
        
        container.style.display = '';
        
        // Build HTML for each option group
        options.forEach(function(opt) {
          var propKey = (opt.optionName || '').trim();
          var valuesStr = opt.optionValues || '';
          var valuesArr = valuesStr.split(',').map(function(s) { return s.trim(); }).filter(Boolean);
          
          if (!propKey || valuesArr.length === 0) return;
          
          var firstValue = valuesArr[0];
          
          var groupHtml = `
            <div class="sb-io__group" data-sb-io-group>
              <div class="sb-io__group-inner">
                <div class="sb-io__product-thumb"><img src="" alt="" data-sb-io-thumb-img></div>
                <div class="sb-io__group-content">
              <span class="product-form__option-name text--strong sb-io__title">${escapeHtml(propKey)}: <span class="product-form__selected-value" data-sb-io-selected-label></span></span>
              <div class="variant-swatch-list sb-io__swatches" role="radiogroup" aria-label="${escapeHtml(propKey)}">
                ${valuesArr.map(function(v, index) {
                  var inputId = 'sb-io-js-' + escapeHtml(propKey).replace(/\\s+/g, '-') + '-' + index;
                  return '<div class="variant-swatch"><input class="variant-swatch__radio" type="radio" name="sb-io-js-' + escapeHtml(propKey) + '" id="' + inputId + '" value="' + escapeHtml(v) + '" data-sb-io-swatch data-prop-key="' + escapeHtml(propKey) + '" data-option-value="' + escapeHtml(v) + '"' + (index === 0 ? ' checked' : '') + '><label class="variant-swatch__item" for="' + inputId + '" title="' + escapeHtml(v) + '"><div class="aspect-ratio" style="padding-bottom: 100%"></div></label></div>';
                }).join('')}
              </div>
                </div>
              </div>
              <input type="hidden" name="properties[${escapeHtml(propKey)}]" value="${escapeHtml(firstValue)}" data-sb-io-prop="true" />
            </div>
          `;
          
          groupsContainer.insertAdjacentHTML('beforeend', groupHtml);
        });
        
        // Initialize the newly created swatches
        initSwatches(container, swatchMap, handleMap);
        
        // Update bundle selection
        updateBundleSelection(container);
      }

      // Initialize swatch functionality for a container
      function initSwatches(container, swatchMap, handleMap) {
        container.querySelectorAll('[data-sb-io-group]').forEach(function(group) {
          var hidden = group.querySelector('input[data-sb-io-prop="true"]');
          var swatches = group.querySelectorAll('[data-sb-io-swatch]');
          var selectedLabel = group.querySelector('[data-sb-io-selected-label]');
          if (!hidden || !swatches.length) return;

          function displayLabel(val) {
            var info = handleMap[norm(val)];
            return (info && info.label) || val;
          }

          function updateSelectedLabel(val) {
            if (selectedLabel) selectedLabel.textContent = displayLabel(val);
          }

          function imageFor(val) {
            var key = norm(val);
            if (swatchMap[key]) return swatchMap[key];
            var info = handleMap[key];
            if (!info) return null;
            return variantImageUrl(productCache[info.handle], info.variantId);
          }

          function updateThumb(val) {
            var thumb = group.querySelector('[data-sb-io-thumb-img]');
            if (!thumb) return;
            var url = imageFor(val);
            if (!url) return;
            thumb.src = url;
            thumb.alt = displayLabel(val);
          }

          function paintImage(input, url, alt) {
            if (!url) return;
            var label = input.nextElementSibling;
            var aspect = label && label.querySelector('.aspect-ratio');
            if (!aspect || aspect.querySelector('img')) return;
            var img = document.createElement('img');
            img.alt = alt || input.getAttribute('data-option-value') || '';
            img.src = url;
            aspect.appendChild(img);
          }

          var list = group.querySelector('.sb-io__swatches');
          var handles = {};
          swatches.forEach(function(input) {
            var info = handleMap[norm(input.getAttribute('data-option-value') || '')];
            if (info && info.handle && !swatchMap[norm(input.getAttribute('data-option-value') || '')]) {
              handles[info.handle] = true;
            }
          });

          function paintAll() {
            swatches.forEach(function(input) {
              var val = input.getAttribute('data-option-value') || '';
              var mapped = swatchMap[norm(val)];
              if (mapped) {
                paintImage(input, mapped, val);
                return;
              }
              var info = handleMap[norm(val)];
              if (!info) return;
              paintImage(input, variantImageUrl(productCache[info.handle], info.variantId), info.label || val);
            });
            collapseToTwoRows(list);
            var current = group.querySelector('[data-sb-io-swatch]:checked');
            if (current) updateThumb(current.getAttribute('data-option-value') || '');
            revealSwatches(list);
          }

          function collapseToTwoRows(list) {
            if (!list) return;
            var tiles = list.querySelectorAll('.variant-swatch');
            if (tiles.length < 3) return;
            var tops = [];
            tiles.forEach(function(tile) {
              if (tops.indexOf(tile.offsetTop) === -1) tops.push(tile.offsetTop);
            });
            if (tops.length <= 2) return;
            var twoRowHeight = tops[2] - tops[0];
            list.style.maxHeight = twoRowHeight + 'px';
            list.classList.add('is-collapsed');

            var more = list.parentNode.querySelector('[data-sb-io-more]');
            if (!more) {
              more = document.createElement('button');
              more.type = 'button';
              more.className = 'sb-io__more';
              more.setAttribute('data-sb-io-more', 'true');
              list.insertAdjacentElement('afterend', more);
              more.addEventListener('click', function() {
                var open = list.classList.contains('is-collapsed');
                if (open) {
                  list.style.maxHeight = '';
                  list.classList.remove('is-collapsed');
                  more.textContent = 'Show less';
                } else {
                  list.style.maxHeight = twoRowHeight + 'px';
                  list.classList.add('is-collapsed');
                  more.textContent = 'Show more';
                }
              });
            }
            if (list.classList.contains('is-collapsed')) more.textContent = 'Show more';
          }

          var handleList = Object.keys(handles);
          if (!handleList.length) {
            paintAll();
          } else {
            var left = handleList.length;
            handleList.forEach(function(handle) {
              fetchProduct(handle, function() {
                left -= 1;
                if (left === 0) paintAll();
              });
            });
          }

          function setActive(input) {
            input.checked = true;
            var val = input.getAttribute('data-option-value') || input.value || '';
            hidden.value = val;
            updateSelectedLabel(val);
            updateThumb(val);
            setTimeout(function() {
              updateBundleSelection(container);
            }, 10);
          }

          var checked = group.querySelector('[data-sb-io-swatch]:checked') || swatches[0];
          if (checked) setActive(checked);

          swatches.forEach(function(input) {
            input.addEventListener('change', function() { setActive(input); });
          });
        });
      }

      // Build _bundle_selection from all selected options
      function updateBundleSelection(container) {
        var bundleSelectionInput = container.querySelector('[data-sb-io-bundle-selection]');
        if (!bundleSelectionInput) {
          // Try to find in form
          var form = container.closest('form');
          if (form) {
            bundleSelectionInput = form.querySelector('input[name="properties[_bundle_selection]"]');
          }
        }
        
        if (!bundleSelectionInput) {
          // Create it if doesn't exist
          bundleSelectionInput = document.createElement('input');
          bundleSelectionInput.type = 'hidden';
          bundleSelectionInput.name = 'properties[_bundle_selection]';
          bundleSelectionInput.setAttribute('data-sb-io-bundle-selection', 'true');
          container.appendChild(bundleSelectionInput);
        }

        // Gather all selected values
        var values = [];
        container.querySelectorAll('input[data-sb-io-prop="true"]').forEach(function(input) {
          if (input.value) {
            values.push(input.value);
          }
        });

        bundleSelectionInput.value = values.join(' <> ');
      }

      // Main initialization
      function init() {
        var container = document.querySelector('[data-sb-io]');
        if (!container) return;
        
        var variantOptionsMap = parseMap('sb-variant-options-map');
        var swatchMap = parseMap('sb-swatch-map');
        var lastVariantId = null;

        // Refresh swatches for current variant
        function refresh() {
          var variantId = getSelectedVariantId();
          if (!variantId) return;
          
          // Only re-render if variant changed
          if (variantId === lastVariantId) return;
          lastVariantId = variantId;
          
          var variantData = variantOptionsMap[variantId];
          
          if (variantData && variantData.options) {
            container.classList.add('sb-io--loading');
            
            // Small delay for visual feedback
            setTimeout(function() {
              renderSwatches(container, variantData.options, variantData.bundled_variants);
              container.classList.remove('sb-io--loading');
            }, 50);
          } else {
            // No IO options for this variant
            container.style.display = 'none';
          }
        }

        // Hook into variant changes
        function hookVariantChanges() {
          // 1) Listen for changes on [name="id"] selects/inputs
          document.addEventListener('change', function(e) {
            var t = e.target;
            if (t && (t.matches('[name="id"]') || t.matches('select[name="id"]'))) {
              setTimeout(refresh, 10);
            }
          });
          
          // 2) Watch for [name="id"] value changes via mutation
          var idFields = document.querySelectorAll('[name="id"]');
          idFields.forEach(function(field) {
            var obs = new MutationObserver(function() {
              setTimeout(refresh, 10);
            });
            obs.observe(field, { attributes: true, attributeFilter: ['value'] });
          });
          
          // 3) History API changes (?variant=...)
          var _push = history.pushState;
          var _replace = history.replaceState;
          
          history.pushState = function() {
            var r = _push.apply(this, arguments);
            window.dispatchEvent(new Event('sb:history'));
            return r;
          };
          history.replaceState = function() {
            var r = _replace.apply(this, arguments);
            window.dispatchEvent(new Event('sb:history'));
            return r;
          };
          
          window.addEventListener('popstate', function() { setTimeout(refresh, 10); });
          window.addEventListener('sb:history', function() { setTimeout(refresh, 10); });
          
          // 4) Common theme events
          ['variant:change', 'product:variant-change', 'theme:variant:change', 'shopify:section:load'].forEach(function(ev) {
            document.addEventListener(ev, function() { setTimeout(refresh, 10); });
          });
          
          // 5) Click on variant buttons/swatches (for themes that use buttons instead of selects)
          document.addEventListener('click', function(e) {
            var btn = e.target.closest('[data-variant-id], [data-option-value]:not([data-sb-io-swatch])');
            if (btn) {
              setTimeout(refresh, 100);
              setTimeout(refresh, 300);
            }
          });
        }

        replaceAppDropdowns();
        var appWatch = new MutationObserver(function() { replaceAppDropdowns(); });
        appWatch.observe(document.body, { childList: true, subtree: true });

        // Initial setup
        var initialVariantId = getSelectedVariantId();
        lastVariantId = initialVariantId;
        
        // Initialize the server-rendered swatches
        var initialData = variantOptionsMap[initialVariantId];
        if (initialData) {
          var handleMap = buildHandleMap(initialData.bundled_variants);
          initSwatches(container, swatchMap, handleMap);
          updateBundleSelection(container);
        }
        
        // Hook variant changes
        hookVariantChanges();
        
        // Also refresh on late-loading themes
        setTimeout(refresh, 250);
        setTimeout(refresh, 900);
      }

      // Run on DOM ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>

{% endif %}
