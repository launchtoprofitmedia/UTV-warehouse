{% comment %}
Simple Bundles Infinite Options - Image Swatches via Metaobjects (store-agnostic)
With dynamic product image thumbnails next to each option group
WITH VARIANT SWITCHING SUPPORT - swatches update when variant changes

Metaobject definition type: product-swatches
Liquid access: shop.metaobjects.product_swatches.values

We DO NOT rely on metaobject handle (some stores block handle in Liquid).
Instead, we build a map keyed by normalized swatch name text and match by normalized option value.

Expected swatch metaobject fields:
- image (Image/File)  -> actual uploaded swatch image
- one text field that stores the swatch name (eg "Sugar Rush", "Red Apple Red")
  Common keys: name, title, label, product_image, product_swatches, productSwatches, swatch_name

Cart:
- Submits line item properties: properties[optionName] = selected value
- Submits properties[_bundle_selection] = all selected values joined by " <> "

Place this snippet INSIDE the product form in the main product section file.
{% endcomment %}

{% comment %} Check if ANY variant has IO options (not just selected variant) {% endcomment %}
{% assign has_any_io = false %}
{% for v in product.variants %}
  {% assign v_io = v.metafields.simple_bundles.variant_options.value %}
  {% if v_io != blank %}
    {% assign first_item = v_io.first %}
    {% if first_item.optionValues != blank and first_item.optionName != blank %}
      {% assign has_any_io = true %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}

{% if has_any_io %}

  {% assign sw_list = shop.metaobjects.product_swatches.values %}

  {%- comment -%}
    Build JSON map: normalized_name -> image_url (for swatches)
    We try multiple possible text field keys for the swatch "name".
    We also support both mo.image and mo.image.value depending on Shopify field behavior.
    
    NORMALIZATION: We strip apostrophes and quotes in Liquid to match JS normalization.
    This handles cases like "L'heure bleue" -> "lheure bleue"
  {%- endcomment -%}

  <script type="application/json" id="sb-swatch-map">
  {
    {%- assign first = true -%}
    {%- for mo in sw_list -%}

      {%- comment -%} 1) Determine swatch label (text) {%- endcomment -%}
      {%- assign label = '' -%}

      {%- if mo.name != blank -%}{%- assign label = mo.name.value | default: mo.name -%}{%- endif -%}
      {%- if label == blank and mo.title != blank -%}{%- assign label = mo.title.value | default: mo.title -%}{%- endif -%}
      {%- if label == blank and mo.label != blank -%}{%- assign label = mo.label.value | default: mo.label -%}{%- endif -%}

      {%- comment -%}
        Your store mentioned a text field called "product-image".
        Its key in Liquid is usually product_image (underscore), not product-image.
      {%- endcomment -%}
      {%- if label == blank and mo.product_image != blank -%}{%- assign label = mo.product_image.value | default: mo.product_image -%}{%- endif -%}
      {%- if label == blank and mo.product_swatches != blank -%}{%- assign label = mo.product_swatches.value | default: mo.product_swatches -%}{%- endif -%}
      {%- if label == blank and mo.swatch_name != blank -%}{%- assign label = mo.swatch_name.value | default: mo.swatch_name -%}{%- endif -%}

      {%- assign label = label | strip -%}
      
      {%- comment -%} NORMALIZE the label: lowercase + remove apostrophes/quotes {%- endcomment -%}
      {%- assign label_normalized = label | downcase | replace: "'", "" | replace: "'", "" | replace: "'", "" | replace: "`", "" | replace: '"', "" | replace: '"', "" | replace: '"', "" -%}

      {%- comment -%} 2) Determine image object/value {%- endcomment -%}
      {%- assign img_obj = mo.image -%}
      {%- if img_obj == blank and mo.image != blank -%}
        {%- assign img_obj = mo.image.value -%}
      {%- endif -%}

      {%- comment -%} 3) Build entry if we have both label + image {%- endcomment -%}
      {%- if label != blank and img_obj != blank -%}
        {%- unless first -%},{%- endunless -%}
        {%- assign first = false -%}
        "{{ label_normalized | escape }}": "{{ img_obj | image_url: width: 120 }}"
      {%- endif -%}

    {%- endfor -%}
  }
  </script>

  {%- comment -%}
    Build JSON map for ALL variants: variant_id -> { options: [...], bundled_variants: [...] }
    This enables dynamic switching when customer changes variants
  {%- endcomment -%}
  <script type="application/json" id="sb-variant-options-map">
  {
    {%- assign first_v = true -%}
    {%- for v in product.variants -%}
      {%- assign v_io = v.metafields.simple_bundles.variant_options.value -%}
      {%- assign v_bv = v.metafields.simple_bundles.bundled_variants.value -%}
      {%- if v_io != blank -%}
        {%- unless first_v -%},{%- endunless -%}
        {%- assign first_v = false -%}
        "{{ v.id }}": {
          "options": {{ v_io | json }},
          "bundled_variants": {{ v_bv | default: "[]" | json }}
        }
      {%- endif -%}
    {%- endfor -%}
  }
  </script>

  <div class="sb-io" data-sb-io data-product-id="{{ product.id }}">
    <style>
      .sb-io { margin: 12px 0; }
      .sb-io__group { margin: 16px 0; }
      
      /* Container for image + content side by side */
      .sb-io__group-inner {
        display: flex;
        align-items: flex-start;
        gap: 16px;
      }
      
      /* Product thumbnail next to swatches */
      .sb-io__product-thumb {
        width: 120px;
        height: 120px;
        min-width: 120px;
        border: 1px solid rgba(0,0,0,.1);
        border-radius: 8px;
        overflow: hidden;
        background: #f9f9f9;
      }
      .sb-io__product-thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: opacity 0.2s ease;
      }
      
      /* Content area (title + swatches) */
      .sb-io__group-content {
        flex: 1;
        min-width: 0;
      }

      .sb-io__swatches .variant-swatch {
        flex: 0 0 auto;
      }

      @media screen and (max-width: 640px) {
        .sb-io__group-inner {
          display: grid;
          grid-template-columns: 120px minmax(0, 1fr);
          gap: 10px 12px;
          align-items: center;
        }

        .sb-io__group-content {
          display: contents;
        }

        .sb-io__product-thumb {
          grid-column: 1;
          grid-row: 1;
        }

        .sb-io__title {
          grid-column: 2;
          grid-row: 1;
          margin: 0;
        }

        .sb-io__swatches,
        .sb-io__more {
          grid-column: 1 / -1;
        }
      }
      
      .sb-io__title { font-weight: 700; margin: 0 0 4px; font-size: 14px; text-transform: uppercase; }
      .sb-io__selected-label { font-size: 14px; margin: 0 0 10px; color: #666; }
      .sb-io__selected-label span { color: #000; }
      .sb-io__swatches { display:flex; flex-wrap:wrap; gap:10px; }
      .sb-io__swatches:not([data-sb-io-ready]) { opacity: 0; }
      .sb-io__swatches.is-collapsed { overflow: hidden; }
      .sb-io__more {
        display: inline-block;
        margin: 2px 0 12px;
        padding: 0;
        border: 0;
        background: none;
        color: inherit;
        font: inherit;
        font-size: 14px;
        font-weight: 700;
        text-decoration: underline;
        cursor: pointer;
      }

      .sb-io__swatch {
        width: 44px;
        height: 44px;
        border-radius: 999px;
        border: 1px solid rgba(0,0,0,.2);
        cursor: pointer;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        position: relative;
        overflow: hidden;
      }
      .sb-io__swatch[aria-pressed="true"] {
        border-color: rgba(0,0,0,.9);
        box-shadow: 0 0 0 2px rgba(0,0,0,.9);
      }

      .sb-io__swatch.is-text,
      .sb-io__swatch.is-image {
        flex: 1 1 100%;
        width: 100%;
        height: auto;
        min-height: 64px;
        border-radius: 10px;
        padding: 0;
        background: #fff;
        background-image: none !important;
        font-size: 14px;
        line-height: 1.3;
        justify-content: flex-start;
        text-align: left;
        white-space: normal;
      }

      .sb-io__swatch.is-text {
        padding: 10px 12px;
      }

      .sb-io__swatch-photo {
        width: 64px;
        height: 64px;
        object-fit: cover;
        flex: 0 0 64px;
      }

      .sb-io__swatch-label {
        padding: 8px 10px;
        text-align: left;
      }

      /* The app dropdowns stay in the form for Simple Bundles, but shoppers use the swatches. */
      #simple-bundles-io-options[data-sb-io-replaced] {
        display: none !important;
      }

      .sb-io__hint { font-size: 12px; opacity: .8; margin-top: 8px; }
      .sb-io__sr { position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden; }
      
      /* Loading state */
      .sb-io--loading { opacity: 0.5; pointer-events: none; }
    </style>

    {%- comment -%} Initial render for selected variant - will be replaced by JS on variant change {%- endcomment -%}
    <div class="sb-io__groups" data-sb-io-groups>
      {% assign sb_io = product.selected_or_first_available_variant.metafields.simple_bundles.variant_options.value %}
      {% assign bundled_variants = product.selected_or_first_available_variant.metafields.simple_bundles.bundled_variants.value %}
      
      {% for opt in sb_io %}
        {% assign prop_key = opt.optionName | default: '' %}
        {% assign values_arr = opt.optionValues | default: '' | split: ',' %}

        {% if prop_key != blank %}
          <div class="sb-io__group" data-sb-io-group>
            <div class="sb-io__group-inner">
              <div class="sb-io__product-thumb">
                <img src="" alt="" data-sb-io-thumb-img>
              </div>
              <div class="sb-io__group-content">
            <span class="product-form__option-name text--strong sb-io__title">{{ prop_key }}: <span class="product-form__selected-value" data-sb-io-selected-label></span></span>
            <div class="variant-swatch-list sb-io__swatches" role="radiogroup" aria-label="{{ prop_key | escape }}">
              {% assign first_value = '' %}
              {% for v in values_arr %}
                {% assign v_clean = v | strip %}
                {% if v_clean != blank %}
                  {% if first_value == '' %}{% assign first_value = v_clean %}{% endif %}
                  {% assign swatch_input_id = 'sb-io-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index %}
                  <div class="variant-swatch">
                    <input
                      class="variant-swatch__radio"
                      type="radio"
                      name="sb-io-{{ forloop.parentloop.index }}"
                      id="{{ swatch_input_id }}"
                      value="{{ v_clean | escape }}"
                      data-sb-io-swatch
                      data-prop-key="{{ prop_key | escape }}"
                      data-option-value="{{ v_clean | escape }}"
                      {% if v_clean == first_value %}checked{% endif %}
                    >
                    <label class="variant-swatch__item" for="{{ swatch_input_id }}" title="{{ v_clean | escape }}">
                      <div class="aspect-ratio" style="padding-bottom: 100%"></div>
                    </label>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
              </div>
            </div>
            <input type="hidden" name="properties[{{ prop_key | escape }}]" value="{{ first_value | escape }}" data-sb-io-prop="true">
          </div>
        {% endif %}
      {% endfor %}
    </div>
    
    {%- comment -%} Hidden input for _bundle_selection - managed by JS {%- endcomment -%}
    <input type="hidden" name="properties[_bundle_selection]" value="" data-sb-io-bundle-selection />
  </div>

  <script>
    (function () {
