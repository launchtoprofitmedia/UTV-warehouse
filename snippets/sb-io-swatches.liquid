        // Greens
        'green': '#008000',
        'lime': '#32CD32',
        'olive': '#808000',
        'mint': '#98FF98',
        'sage': '#BCB88A',
        'emerald': '#50C878',
        'forest': '#228B22',
        'teal': '#008080',
        'seafoam': '#93E9BE',
        'jade': '#00A86B',
        'hunter green': '#355E3B',
        
        // Blues
        'blue': '#0000FF',
        'navy': '#000080',
        'royal blue': '#4169E1',
        'sky blue': '#87CEEB',
        'baby blue': '#89CFF0',
        'powder blue': '#B0E0E6',
        'cobalt': '#0047AB',
        'indigo': '#4B0082',
        'turquoise': '#40E0D0',
        'aqua': '#00FFFF',
        'cyan': '#00FFFF',
        'denim': '#1560BD',
        'steel blue': '#4682B4',
        
        // Purples
        'purple': '#800080',
