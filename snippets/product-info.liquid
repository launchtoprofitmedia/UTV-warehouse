{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product_form_' | append: section.id | append: product.id -%}

<div class="card {% if product.media.size > 0 %}card--collapsed{% endif %} {% if template.name == 'product' %}card--sticky{% endif %}">
  {%- if section.settings.enable_image_zoom -%}
    <div id="product-zoom-{{ section.id }}" class="product__zoom-wrapper"></div>
  {%- endif -%}

  <div class="card__section">
    {%- form 'product', product, id: product_form_id, class: 'product-form' -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product_meta' -%}
            {%- render 'product-meta', product: product, block: block -%}

          {%- when 'variant_selector' -%}
            {%- render 'product-variant-selector', product: product, form: form, block: block -%}

          {%- when 'buy_buttons' -%}
            {%- render 'product-buy-buttons', product: product, form: form, block: block -%}
            {%- render 'product-banner' -%}

          {%- when 'product_accordion' -%}
            {%- assign mf_what_you_get_benefits = product.metafields.custom.what_you_get_benefits -%}
            {%- assign mf_what_you_get = product.metafields.custom.what_you_get -%}
            {%- assign mf_full_specifications = product.metafields.custom.full_specifications
              | default: product.metafields.custom.full_specification
              | default: product.metafields.custom.specifications
              | default: product.metafields.custom.full_specs
            -%}
            {%- assign mf_size_chart_fit_guide = product.metafields.custom.size_chart_and_fit_guide -%}
            {%- assign mf_shipping_returns = product.metafields.custom.shipping_and_returns -%}

            {%- assign has_item_1 = false -%}
            {%- assign has_item_2 = false -%}
            {%- assign has_item_3 = false -%}
            {%- assign has_item_4 = false -%}

            {%- if mf_what_you_get_benefits != blank or mf_what_you_get != blank or block.settings.item_1_content != blank -%}
              {%- assign has_item_1 = true -%}
            {%- endif -%}

            {%- if mf_full_specifications != blank or block.settings.item_2_content != blank -%}
              {%- assign has_item_2 = true -%}
            {%- endif -%}

            {%- if mf_size_chart_fit_guide != blank or block.settings.item_3_content != blank -%}
              {%- assign has_item_3 = true -%}
            {%- endif -%}

            {%- if mf_shipping_returns != blank or block.settings.item_4_content != blank -%}
              {%- assign has_item_4 = true -%}
            {%- endif -%}

            {%- if has_item_1 or has_item_2 or has_item_3 or has_item_4 -%}
              <div class="product-meta__accordion" aria-label="{{ block.settings.aria_label | escape }}" {{ block.shopify_attributes }}>
                <div class="card">
                  {%- if has_item_1 -%}
                    <button class="card__collapsible-button" data-action="toggle-collapsible" aria-expanded="false" aria-controls="block-{{ section.id }}-{{ block.id }}-item-1">
                      <span class="card__title heading h3">{{ block.settings.item_1_title | escape }}</span>
                      <span class="plus-button plus-button--large"></span>
                    </button>

                    <div id="block-{{ section.id }}-{{ block.id }}-item-1" class="card__collapsible">
                      <div class="card__collapsible-content">
                        <div class="rte text--pull">
                          {%- if mf_what_you_get_benefits != blank -%}
                            {{ mf_what_you_get_benefits | metafield_tag }}
                          {%- elsif mf_what_you_get != blank -%}
                            {{ mf_what_you_get | metafield_tag }}
                          {%- elsif block.settings.item_1_content != blank -%}
                            {{ block.settings.item_1_content }}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if has_item_2 -%}
                    <button class="card__collapsible-button" data-action="toggle-collapsible" aria-expanded="false" aria-controls="block-{{ section.id }}-{{ block.id }}-item-2">
                      <span class="card__title heading h3">{{ block.settings.item_2_title | escape }}</span>
                      <span class="plus-button plus-button--large"></span>
                    </button>

                    <div id="block-{{ section.id }}-{{ block.id }}-item-2" class="card__collapsible">
                      <div class="card__collapsible-content">
                        <div class="rte text--pull">
                          {%- if mf_full_specifications != blank -%}
                            {{ mf_full_specifications | metafield_tag }}
                          {%- elsif block.settings.item_2_content != blank -%}
                            {{ block.settings.item_2_content }}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if has_item_3 -%}
                    <button class="card__collapsible-button" data-action="toggle-collapsible" aria-expanded="false" aria-controls="block-{{ section.id }}-{{ block.id }}-item-3">
                      <span class="card__title heading h3">{{ block.settings.item_3_title | escape }}</span>
                      <span class="plus-button plus-button--large"></span>
                    </button>

                    <div id="block-{{ section.id }}-{{ block.id }}-item-3" class="card__collapsible">
                      <div class="card__collapsible-content">
                        <div class="rte text--pull">
                          {%- if mf_size_chart_fit_guide != blank -%}
                            {{ mf_size_chart_fit_guide | metafield_tag }}
                          {%- elsif block.settings.item_3_content != blank -%}
                            {{ block.settings.item_3_content }}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if has_item_4 -%}
                    <button class="card__collapsible-button" data-action="toggle-collapsible" aria-expanded="false" aria-controls="block-{{ section.id }}-{{ block.id }}-item-4">
                      <span class="card__title heading h3">{{ block.settings.item_4_title | escape }}</span>
                      <span class="plus-button plus-button--large"></span>
                    </button>

                    <div id="block-{{ section.id }}-{{ block.id }}-item-4" class="card__collapsible">
                      <div class="card__collapsible-content">
                        <div class="rte text--pull">
                          {%- if mf_shipping_returns != blank -%}
                            {{ mf_shipping_returns | metafield_tag }}
                          {%- elsif block.settings.item_4_content != blank -%}
                            {{ block.settings.item_4_content }}
                          {%- endif -%}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'text' -%}
            {%- if block.settings.content != blank -%}
              <div class="product-meta__text rte" {{ block.shopify_attributes }}>
                {{- block.settings.content -}}
              </div>
            {%- endif -%}

          {%- when 'button' -%}
            {%- if block.settings.text != blank -%}
              <a href="{{ block.settings.link }}" class="product-meta__button button button--primary" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
            {%- endif -%}

          {%- when 'custom_product_faq' -%}
            {%- assign metafield_parts = block.settings.metafield_key | default: '' | strip | split: '.' -%}
            {%- assign mf_namespace = '' -%}
            {%- assign mf_key = '' -%}

            {%- if metafield_parts.size == 2 -%}
              {%- assign mf_namespace = metafield_parts[0] | strip -%}
              {%- assign mf_key = metafield_parts[1] | strip -%}
            {%- endif -%}

            {%- assign faq_title_down = block.settings.title | downcase -%}

            {%- if mf_namespace == blank or mf_key == blank -%}
              {%- if faq_title_down contains 'specification' -%}
                {%- assign mf_namespace = 'custom' -%}
                {%- assign mf_key = 'full_specifications' -%}
              {%- elsif faq_title_down contains 'size chart' or faq_title_down contains 'fit guide' -%}
                {%- assign mf_namespace = 'custom' -%}
                {%- assign mf_key = 'size_chart_and_fit_guide' -%}
              {%- elsif faq_title_down contains 'shipping' or faq_title_down contains 'return' -%}
                {%- assign mf_namespace = 'custom' -%}
                {%- assign mf_key = 'shipping_and_returns' -%}
              {%- elsif faq_title_down contains 'what you get' or faq_title_down contains 'benefit' -%}
                {%- assign mf_namespace = 'custom' -%}
                {%- assign mf_key = 'what_you_get_benefits' -%}
              {%- endif -%}
            {%- endif -%}

            {%- assign faq_metafield = blank -%}
            {%- if mf_namespace != blank and mf_key != blank -%}
              {%- assign faq_metafield = product.metafields[mf_namespace][mf_key] -%}
            {%- endif -%}

            {%- if faq_metafield == blank and faq_title_down contains 'specification' -%}
              {%- assign faq_metafield = product.metafields.custom.full_specifications
                | default: product.metafields.custom.full_specification
                | default: product.metafields.custom.specifications
                | default: product.metafields.custom.full_specs
              -%}
            {%- endif -%}

            {%- assign faq_has_answer = false -%}
            {%- if faq_metafield != blank or block.settings.content != blank or block.settings.image != blank -%}
              {%- assign faq_has_answer = true -%}
            {%- endif -%}

            {%- if block.settings.title != blank and faq_has_answer -%}
              <div class="product-meta__faq-item faq__item" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="card__collapsible-button faq__question heading h4"
                  data-action="toggle-collapsible"
                  aria-expanded="false"
                  aria-controls="block-{{ section.id }}-{{ block.id }}">
                  <span itemprop="name">{{ block.settings.title | escape }}</span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 20 20"
                    fill="none"
                    class="faq__icon">
                    <path d="M5 14.2097L14 14.2097L9.6188 6.20972L5 14.2097Z" fill="#5F5F5F" />
                  </svg>
                </button>

                <div id="block-{{ section.id }}-{{ block.id }}" class="card__collapsible faq__answer-wrapper">
                  <div class="card__collapsible-content">
                    {%- if faq_metafield != blank -%}
                      {%- if faq_title_down contains 'specification' -%}
                        {%- capture specs_html -%}{{ faq_metafield | metafield_tag }}{%- endcapture -%}
                        {%- assign specs_chunks = specs_html
                          | replace: '</li>', '|||'
                          | replace: '<br />', '|||'
                          | replace: '<br>', '|||'
                          | replace: '</p>', '|||'
                          | replace: '</tr>', '|||'
                          | split: '|||'
                        -%}

                        {%- if specs_chunks.size > 1 -%}
                          <div class="custom-specs-table" itemprop="text">
                            {%- for chunk in specs_chunks -%}
                              {%- assign line_stripped = chunk | strip_html | strip -%}
                              {%- if line_stripped != blank -%}
                                {%- assign parts = line_stripped | split: ' - ' -%}
                                {%- if parts.size < 2 -%}
                                  {%- assign parts = line_stripped | split: '-' -%}
                                {%- endif -%}

                                {%- assign spec_key = parts[0] | strip -%}
                                {%- assign spec_value = parts | slice: 1, 50 | join: ' - ' | strip -%}

                                {%- if spec_key != blank and spec_value != blank -%}
                                  <div class="custom-specs-table__row">
                                    <div class="custom-specs-table__key">{{ spec_key | escape }}</div>
                                    <div class="custom-specs-table__sep">-</div>
                                    <div class="custom-specs-table__value">{{ spec_value | escape }}</div>
                                  </div>
                                {%- endif -%}
                              {%- endif -%}
                            {%- endfor -%}
                          </div>
                        {%- else -%}
                          <div class="faq__answer rte text--pull" itemprop="text">
                            {{ faq_metafield | metafield_tag }}
                          </div>
                        {%- endif -%}
                      {%- else -%}
                        <div class="faq__answer rte text--pull" itemprop="text">
                          {{ faq_metafield | metafield_tag }}
                        </div>
                      {%- endif -%}
                    {%- elsif block.settings.content != blank -%}
                      <div class="faq__answer rte text--pull" itemprop="text">
                        {{ block.settings.content }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.image != blank -%}
                      <div class="faq__answer-image">
                        {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '320,480,640,800,1000,1200', sizes: '(min-width: 1000px) 560px, 100vw', alt: block.settings.title | escape }}
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}

          {%- when 'store_pickup' -%}
            {%- comment -%}The availability container will be added automatically if there is store pickup available{%- endcomment -%}
            <div class="product-meta__store-availability-container" {{ block.shopify_attributes }}>
              {%- render 'store-availability', product_variant: product.selected_or_first_available_variant -%}
            </div>

          {%- when 'featured_description' -%}
            {%- comment -%}This is only shown on the featured product section{%- endcomment -%}
            {%- if product.description != blank -%}
              <div class="product-meta__description rte" {{ block.shopify_attributes }}>
                {{ product.description | remove: 'data-section-type="product"' }}
              </div>
            {%- endif -%}

          {%- when '@app' -%}
            {%- render block -%}
        {%- endcase -%}
      {%- endfor -%}

      {%- assign product_meta_block = section.blocks | where: 'type', 'product_meta' | first -%}

      {%- if product_meta_block != blank and product_meta_block.settings.show_share_buttons -%}
        <div class="product-meta__share-buttons hidden-tablet-and-up">
          <span class="text--strong">{{ 'product.general.share' | t }}</span>

          {%- assign share_url = shop.url | append: product.url | url_param_escape -%}
          {%- assign twitter_text = product.title | url_param_escape -%}
          {%- assign pinterest_description = product.description | strip_html | truncatewords: 15 | url_param_escape -%}
          {%- assign pinterest_image = product.featured_media | img_url: '1024x' | prepend: 'https:' -%}

          <ul class="social-media__item-list list--unstyled" role="list">
            <li class="social-media__item social-media__item--facebook">
              <a href="https://www.facebook.com/sharer.php?u={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.facebook_share' | t }}">{%- render 'icon', icon: 'facebook' -%}</a>
            </li>

            <li class="social-media__item social-media__item--pinterest">
              <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}{% if pinterest_image != blank %}&media={{ pinterest_image }}{% endif %}&description={{ pinterest_description }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.pinterest_pin' | t }}">{%- render 'icon', icon: 'pinterest' -%}</a>
            </li>

            <li class="social-media__item social-media__item--twitter">
              <a href="https://twitter.com/share?{% if twitter_text != blank %}text={{twitter_text}}&{% endif %}url={{ share_url }}" target="_blank" rel="noopener" aria-label="{{ 'general.social.twitter_tweet' | t }}">{%- render 'icon', icon: 'twitter' -%}</a>
            </li>

            <li class="social-media__item">
              <a href="mailto:?&subject={{ product.title | escape }}&body={{ share_url }}" aria-label="{{ 'general.social.email_share' | t }}">{% render 'icon', icon: 'email' %}</a>
            </li>
          </ul>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>

  {% comment %}
  ------------------------------------------------------------------------------
  Product Data. This must be outputted for all products (including home page).

  IMPORTANT: THIS CODE IS VITAL. DO NOT EDIT IT NOR REMOVE IT. MAKE SURE TO KEEP
  THE EXACT SAME ATTRIBUTES.
  ------------------------------------------------------------------------------
  {% endcomment %}

  {%- assign variant_selector_block = section.blocks | where: 'type', 'variant_selector' | first -%}

  <script type="application/json" data-product-json>
    {
      "product": {{ product | json }},
      "template": {{ product.template_suffix | json }},
      "options_with_values": {{ product.options_with_values | json }},
      "selected_variant_id": {{ selected_variant.id }}
      {%- if variant_selector_block.settings.show_inventory_quantity -%}
        ,"inventories": {
          {%- for variant in product.variants -%}
            {%- if variant.inventory_management -%}
              {%- if variant.available and variant.inventory_management -%}
                {%- if variant.inventory_quantity <= 0 and variant.requires_shipping -%}
                  {%- if variant.incoming -%}
                    {%- capture next_incoming_date -%}{{ variant.next_incoming_date | date: format: 'date' }}{%- endcapture -%}
                    {%- capture inventory_message -%}{{ 'product.form.incoming_stock' | t: next_incoming_date: next_incoming_date }}{%- endcapture -%}
                  {%- else -%}
                    {%- capture inventory_message -%}{{ 'product.form.oversell_stock' | t }}{%- endcapture -%}
                  {%- endif -%}
                {%- elsif variant_selector_block.settings.low_inventory_threshold > 0 -%}
                  {%- if variant.inventory_quantity <= variant_selector_block.settings.low_inventory_threshold -%}
                    {%- capture inventory_message -%}{{ 'product.form.low_stock_with_quantity_count' | t: count: variant.inventory_quantity }}{%- endcapture -%}
                  {%- else -%}
                    {%- capture inventory_message -%}{{ 'product.form.in_stock_with_quantity_count' | t: count: variant.inventory_quantity }}{%- endcapture -%}
                  {%- endif -%}
                {%- else -%}
                  {%- capture inventory_message -%}{{ 'product.form.in_stock' | t }}{%- endcapture -%}
                {%- endif -%}
              {%- else -%}
                {%- if variant.incoming -%}
                  {%- capture next_incoming_date -%}{{ variant.next_incoming_date | date: format: 'date' }}{%- endcapture -%}
                  {%- capture inventory_message -%}{{ 'product.form.incoming_stock' | t: next_incoming_date: next_incoming_date }}{%- endcapture -%}
                {%- else -%}
                  {%- capture inventory_message -%}{{ 'product.form.sold_out' | t }}{%- endcapture -%}
                {%- endif -%}
              {%- endif -%} 
            {%- else -%}
              {%- capture inventory_message -%}{{ 'product.form.in_stock' | t }}{%- endcapture -%}
            {%- endif -%}

            "{{ variant.id }}": {
              "inventory_management": {{ variant.inventory_management | json }},
              "inventory_policy": {{ variant.inventory_policy | json }},
              "inventory_quantity": {{ variant.inventory_quantity | json }},
              "inventory_message": {{ inventory_message | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        }
      {%- endif -%}
    }
  </script>
</div>