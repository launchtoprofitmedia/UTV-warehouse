{%- comment -%}
  Default page template shows standard page content.
  Alternate templates (default-2, camso-x4s, blogs, and others)
  render their own sections. Assign those in the page admin instead of
  hardcoding page handles here.
{%- endcomment -%}
{%- if request.page_type == 'page' and template.suffix == blank -%}
  content
{%- else -%}
  always
{%- endif -%}