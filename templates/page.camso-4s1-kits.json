      "settings": {
        "title": "SPECIFICATIONS",
        "html": "<table style=\"width: 100%; border-collapse: collapse;\">\n        <!-- Left Column with 8 Rows -->\n        <tbody>\n<tr>\n            <td style=\"padding: 8px; background-color:#2358a8; color:white;\">RUBBER TRACK</td>\n            \n        </tr>\n\n        <tr>\n            <td style=\"padding: 8px; background-color:#ebebeb;\">\n<strong>Width:</strong> Front: 12.5 in. (318 mm) Rear: 14 in. (356 mm)</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 8px;\">\n<strong>Length:</strong> Front 98.5 in. (2507 mm) Rear: 116.7 in. (2964 mm)</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 8px; background-color:#ebebeb;\">\n<strong>Lug height:</strong> Front 1.125 in. (29 mm) Rear: 1.125 in. (29 mm)</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 8px;\">\n<strong>Rubber track:</strong> Front: flex  Rear: flat</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 8px; background-color:#2358a8; color:white;\">PERFORMANCE</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 8px;\">\n<strong>Ground Surface:</strong> 2520 sq. in. (1.62 m<sup>2</sup>)</td>\n        </tr>\n        <tr>\n            <td style=\"padding: 8px; background-color:#ebebeb;\">\n<strong>Maintenance speed (average):</strong> 2/3</td>\n        </tr>\n    </tbody>\n</table>"
