    "c023ed8a-54bc-44ae-8b26-cf9b3aa58c56": {
      "type": "faq",
      "blocks": {
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-separator-1": {
          "type": "separator",
          "settings": {
            "title": "Frequently Asked Questions"
          }
        },
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-question-1": {
          "type": "question",
          "settings": {
            "title": "What Kit Should I Buy?",
            "answer": "<p>Camso offers a range of track systems depending on the machine you have as well as what you intend to do with your tracks.  Visit our track track system comparison page here to see our break down of the different systems. </p>"
          }
        },
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-question-6": {
          "type": "question",
          "settings": {
            "title": "How Do I Order?",
            "answer": "<p>To order a set of tracks please contact us either by phone at (855)-866-8889, by email at Support@utvwarehouse.com or via our chat. When you contact us we will need to know the exact year make and model of your machine. </p>"
          }
        },
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-question-2": {
          "type": "question",
          "settings": {
            "title": "Can I Install The Tracks Myself?",
            "answer": "<p>Yes! All Camso track kits are designed to be easily installed. All you need is a jack or way to lift your machine off the ground and a set of basic hand tools and you can install the kit yourself. The initial install usually takes 2-3 hours.</p>"
          }
        },
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-question-3": {
          "type": "question",
          "settings": {
            "title": "Does UTV Warehouse Offer Installation?",
            "answer": "<p>We do offer installation services for an additional cost at our warehouse in Provo UT. Please contact us by phone or email to check for scheduling and availably as well as pricing for this service.</p>"
          }
        },
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-question-5": {
          "type": "question",
          "settings": {
            "title": "What Is The Shipping Cost?",
            "answer": "<p>These tracks ship via freight. If you need your track shipped to you there may be an additional shipping cost. If your shipping address is a verified commercial address, shipping will be free. If your address is a residential one the shipping cost is $200 to the west coast, and $350 to the east coast. Please contact us if you need more information regarding shipping.</p>"
          }
        },
        "template--14496682868799__c023ed8a-54bc-44ae-8b26-cf9b3aa58c56-question-4": {
          "type": "question",
          "settings": {
            "title": "What Comes With The Kit?",
            "answer": "<p>All kits include a complete set of 4 tracks with mounting hardware for your specific machine, as well as installation instructions and product manuals. </p>"
          }
        }
      },
