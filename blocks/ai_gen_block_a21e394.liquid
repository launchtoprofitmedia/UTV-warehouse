{% doc %}
  @prompt
    an image tile where i can add and delete an image tile, with overlay text, add where i can add a link, just have it where i can post a link, and a main title above, a button to redirect to a link as well, make the title bold and the tile images can be deleted or added, make the tile images above the title and button
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-tiles-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.section_background }};
  }

  .ai-image-tiles__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-image-tiles__header-{{ ai_gen_id }} {
    text-align: center;
    margin-top: 40px;
  }

  .ai-image-tiles__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 20px;
    font-weight: 700;
  }

  .ai-image-tiles__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: background-color 0.3s ease;
  }

  .ai-image-tiles__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-image-tiles__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-image-tile-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.tile_border_radius }}px;
    aspect-ratio: {{ block.settings.tile_aspect_ratio }};
  }

  .ai-image-tile__link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-image-tile__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .ai-image-tile__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-tile__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-tile__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-image-tile__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 20px;
  }

  .ai-image-tile__text-{{ ai_gen_id }} {
    color: {{ block.settings.overlay_text_color }};
    font-size: {{ block.settings.overlay_text_size }}px;
    margin: 0;
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-image-tiles__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-image-tiles__title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.8);
    }

    .ai-image-tile__text-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.overlay_text_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-image-tiles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-tiles__container-{{ ai_gen_id }}">
    <div class="ai-image-tiles__grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign tile_image_key = 'tile_' | append: i | append: '_image'
          assign tile_text_key = 'tile_' | append: i | append: '_text'
          assign tile_link_key = 'tile_' | append: i | append: '_link'

          assign tile_image = block.settings[tile_image_key]
          assign tile_text = block.settings[tile_text_key]
          assign tile_link = block.settings[tile_link_key]
        %}

        {% if tile_image != blank %}
          <div class="ai-image-tile-{{ ai_gen_id }}">
            {% if tile_link != blank %}
              <a href="{{ tile_link }}" class="ai-image-tile__link-{{ ai_gen_id }}">
            {% else %}
              <div class="ai-image-tile__link-{{ ai_gen_id }}">
            {% endif %}
              <div class="ai-image-tile__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ tile_image | image_url: width: 800 }}"
                  alt="{{ tile_image.alt | escape }}"
                  loading="lazy"
                  width="{{ tile_image.width }}"
                  height="{{ tile_image.height }}"
                  class="ai-image-tile__image-{{ ai_gen_id }}"
                >
              </div>
              {% if tile_text != blank %}
                <div class="ai-image-tile__overlay-{{ ai_gen_id }}">
                  <p class="ai-image-tile__text-{{ ai_gen_id }}">{{ tile_text }}</p>
                </div>
              {% endif %}
            {% if tile_link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.main_title != blank or block.settings.main_button_link != blank %}
      <div class="ai-image-tiles__header-{{ ai_gen_id }}">
        {% if block.settings.main_title != blank %}
          <h2 class="ai-image-tiles__title-{{ ai_gen_id }}">{{ block.settings.main_title }}</h2>
        {% endif %}
        {% if block.settings.main_button_link != blank and block.settings.main_button_text != blank %}
          <a href="{{ block.settings.main_button_link }}" class="ai-image-tiles__button-{{ ai_gen_id }}">
            {{ block.settings.main_button_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

