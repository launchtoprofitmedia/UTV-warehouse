{% doc %}
  @prompt
    a block that gives me 6 tiles of images with text overlaying it. With each tile that can be a clickable button to take you to a new page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-tiles-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-image-tile-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    display: block;
    text-decoration: none;
  }

  .ai-image-tile-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .ai-image-tile-{{ ai_gen_id }}:hover .ai-image-tile-image-{{ ai_gen_id }} {
    transform: scale(1.05);
  }

  .ai-image-tile-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-tile-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-tile-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 0%,
      rgba(0, 0, 0, {{ block.settings.overlay_opacity }}) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: {{ block.settings.text_padding }}px;
  }

  .ai-image-tile-title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 700;
    margin: 0 0 8px 0;
    line-height: 1.2;
  }

  .ai-image-tile-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    line-height: 1.4;
    opacity: 0.9;
  }

  @media screen and (max-width: 989px) {
    .ai-image-tiles-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-image-tiles-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-image-tile-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.85);
    }

    .ai-image-tile-description-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.description_size }}px * 0.85);
    }
  }
{% endstyle %}

<div class="ai-image-tiles-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% for i in (1..6) %}
    {% liquid
      assign image_key = 'tile_' | append: i | append: '_image'
      assign title_key = 'tile_' | append: i | append: '_title'
      assign description_key = 'tile_' | append: i | append: '_description'
      assign link_key = 'tile_' | append: i | append: '_link'

      assign tile_image = block.settings[image_key]
      assign tile_title = block.settings[title_key]
      assign tile_description = block.settings[description_key]
      assign tile_link = block.settings[link_key]
    %}

    <a
      href="{% if tile_link != blank %}{{ tile_link }}{% else %}#{% endif %}"
      class="ai-image-tile-{{ ai_gen_id }}"
      {% if tile_link == blank %}aria-disabled="true"{% endif %}
    >
      {% if tile_image %}
        <img
          src="{{ tile_image | image_url: width: 800 }}"
          alt="{{ tile_image.alt | escape }}"
          loading="lazy"
          width="{{ tile_image.width }}"
          height="{{ tile_image.height }}"
          class="ai-image-tile-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-image-tile-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-image-tile-overlay-{{ ai_gen_id }}">
        {% if tile_title != blank %}
          <h3 class="ai-image-tile-title-{{ ai_gen_id }}">{{ tile_title }}</h3>
        {% endif %}
        {% if tile_description != blank %}
          <p class="ai-image-tile-description-{{ ai_gen_id }}">{{ tile_description }}</p>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>

