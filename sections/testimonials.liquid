{% comment %}
  Testimonials Section — Shopify Liquid
  Fully configurable via schema. Each testimonial is a dynamic block.
{% endcomment %}

<section
  class="testimonials-section"
  id="testimonials-{{ section.id }}"
  style="
    --bg-color: {{ section.settings.background_color }};
    --card-bg: {{ section.settings.card_background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --accent-color: {{ section.settings.accent_color }};
    --text-color: {{ section.settings.text_color }};
    --subtext-color: {{ section.settings.subtext_color }};
    --star-color: #EB891B;
    --dot-active-color: {{ section.settings.dot_active_color }};
    --dot-inactive-color: {{ section.settings.dot_inactive_color }};
    --card-border-radius: {{ section.settings.card_border_radius }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="testimonials-inner">

    {% if section.settings.show_badge %}
      <div class="testimonials-stars-badge">
        {% for i in (1..5) %}
          <span class="badge-star">★</span>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="testimonials-heading">
        {% if section.settings.heading_highlight != blank %}
          <span class="heading-highlight">{{ section.settings.heading_highlight }}</span>
        {% endif %}
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="testimonials-subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    {% assign testimonial_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'testimonial' %}
        {% assign testimonial_count = testimonial_count | plus: 1 %}
      {% endif %}
    {% endfor %}
    {% comment %}Carousel always shows exactly 3 testimonials at once{% endcomment %}
    {% assign carousel_visible = 3 %}

    {% if section.blocks.size > 0 %}
      <div class="testimonials-carousel">
        <div
          class="testimonials-carousel__viewport"
          data-carousel
          style="--t-carousel-gap: {{ section.settings.card_gap }}px; --t-carousel-cols: {{ carousel_visible }};">
          <div class="testimonials-track" data-track>
            {% for block in section.blocks %}
              {% if block.type == 'testimonial' %}
                <div class="testimonial-card" {{ block.shopify_attributes }}>
                  <div class="testimonial-stars">
                    {% assign rating = block.settings.rating | default: 5 %}
                    {% for i in (1..5) %}
                      {% if i <= rating %}
                        <span class="star filled">★</span>
                      {% else %}
                        <span class="star empty">★</span>
                      {% endif %}
                    {% endfor %}
                  </div>

                  {% if block.settings.quote != blank %}
                    <blockquote class="testimonial-quote">
                      "{{ block.settings.quote }}"
                    </blockquote>
                  {% endif %}

                  <div class="testimonial-author">
                    <div class="author-avatar" style="background-color: {{ block.settings.avatar_color }};">
                      {{ block.settings.name | slice: 0 | upcase }}
                    </div>
                    <div class="author-meta">
                      <div class="author-name-row">
                        {% if block.settings.name != blank %}
                          <span class="author-name">{{ block.settings.name }}</span>
                        {% endif %}
                        {% if block.settings.show_verified %}
                          <span class="verified-badge">
                            <svg
                              class="verified-badge__check"
                              width="12"
                              height="12"
                              viewBox="0 0 12 12"
                              fill="none"
                              aria-hidden="true">
                              <path
                                d="M2.5 6L5 8.5L9.5 3.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round" />
                            </svg>
                            <span class="verified-badge__label">{{ section.settings.verified_label }}</span>
                          </span>
                        {% endif %}
                      </div>
                      {% if block.settings.rider_type != blank or block.settings.location != blank %}
                        <span class="author-detail">
                          {% if block.settings.rider_type != blank %}
                            {{ block.settings.rider_type }}{% endif %}
                          {% if block.settings.rider_type != blank and block.settings.location != blank %}
                            ·
                          {% endif %}
                          {% if block.settings.location != blank %}
                            {{ block.settings.location }}{% endif %}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        {% comment %}Dots rebuilt in JS — page count depends on responsive cards-per-view{% endcomment %}
        {% if testimonial_count > 1 %}
          <div
            class="testimonials-dots"
            data-dots
            hidden></div>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

<style>
  #testimonials-{{ section.id }} {
    background-color: var(--bg-color);
    padding-top: var(--section-padding-top);
    padding-bottom: var(--section-padding-bottom);
    overflow: hidden;
  }

  #testimonials-{{ section.id }}
  .testimonials-inner {
    max-width: max({{ section.settings.container_width }}px, {{ 3 | times: 433 | plus: section.settings.card_gap | plus: section.settings.card_gap | plus: 84 }}px);
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  /* Badge Stars */
  #testimonials-{{ section.id }} .testimonials-stars-badge {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-bottom: 12px;
  }
  #testimonials-{{ section.id }}
  .badge-star {
    color: var(--star-color);
    font-size: 30px;
    line-height: 1;
  }

  /* Heading */
  #testimonials-{{ section.id }} .testimonials-heading {
    font-family: Goldman;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: 36px;
    text-transform: uppercase;
    margin-bottom: 0;
  }
  #testimonials-{{ section.id }}
  .heading-highlight {
    color: #EB891B;
  }

  /* Subheading (sizes editable in theme editor) */
  #testimonials-{{ section.id }} .testimonials-subheading {
    font-size: {{ section.settings.subheading_font_size | default: 16 }}px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
    color: #000000;
    margin-bottom: clamp(36px, 5vw, 48px);
  }

  /* Outer wrapper: spacing above/below slide row; dots sit outside clipped viewport */
  #testimonials-{{ section.id }} .testimonials-carousel {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    margin-top: clamp(16px, 3vw, 32px);
    margin-bottom: clamp(12px, 2vw, 24px);
  }

  #testimonials-{{ section.id }}
  .testimonials-carousel__viewport {
    position: relative;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    overflow-x: clip;
    /* Side gutter for card shadows; a bit tighter on small screens */
    padding: clamp(28px, 5vw, 52px) clamp(12px, 4vw, 36px);
  }

  #testimonials-{{ section.id }}
  .testimonials-track {
    position: relative;
    box-sizing: border-box;
    display: flex;
    flex-wrap: nowrap;
    width: fit-content;
    min-width: 100%;
    gap: var(--t-carousel-gap);
    transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    will-change: transform;
    align-items: stretch;
  }

  /* Card */
  #testimonials-{{ section.id }} .testimonial-card {
    box-sizing: border-box;
    flex: 0 0 var(--t-card-col-px, 433px);
    width: var(--t-card-col-px, 433px);
    min-width: var(--t-card-col-px, 433px);
    max-width: min(433px, 100%);
    flex-shrink: 0;
    background: white;
    border-radius: var(--card-border-radius);
    padding: {{ section.settings.card_padding }}px;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 16px;
    {% if section.settings.card_shadow %}
      box-shadow: 0 2px 14px 0 rgba(0, 0, 0, 0.14);
    {% endif %}
    {% if section.settings.card_border %}
      border: 1px solid rgba(0, 0, 0, 0.07);
    {% endif %}
  }

  /* Stars on card */
  #testimonials-{{ section.id }} .testimonial-stars {
    display: flex;
    gap: 1px;
  }
  #testimonials-{{ section.id }}
  .testimonial-stars .star {
    font-size: 20px;
    line-height: 1;
  }
  #testimonials-{{ section.id }}
  .testimonial-stars .star.filled {
    color: var(--star-color);
  }
  #testimonials-{{ section.id }}
  .testimonial-stars .star.empty {
    color: #ddd;
  }

  /* Quote */
  #testimonials-{{ section.id }} .testimonial-quote {
    font-size: {{ section.settings.quote_font_size }}px;
    line-height: 1.65;
    color: var(--text-color);
    margin: 0;
    font-style: italic;
    flex: 1;
    overflow-wrap: break-word;
    word-wrap: break-word;
  }

  /* Author */
  #testimonials-{{ section.id }} .testimonial-author {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
  }
  #testimonials-{{ section.id }}
  .author-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
  }
  #testimonials-{{ section.id }}
  .author-meta {
    display: flex;
    flex-direction: column;
  }
  #testimonials-{{ section.id }}
  .author-name-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  #testimonials-{{ section.id }}
  .author-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-color);
  }
  #testimonials-{{ section.id }}
  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    background: none;
    border-radius: 0;
    padding: 0;
    color: #EB891B;
  }
  #testimonials-{{ section.id }}
  .verified-badge__check {
    flex-shrink: 0;
    color: var(--accent-color);
  }
  #testimonials-{{ section.id }}
  .verified-badge__label {
    font-size: 12px;
    font-style: normal;
    font-weight: 400;
    line-height: 14px;
    color: #5F5F5F;
  }
  #testimonials-{{ section.id }}
  .author-detail {
    font-size: 11px;
    color: var(--subtext-color);
  }

  /* Dots */
  #testimonials-{{ section.id }} .testimonials-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: clamp(36px, 5vw, 52px);
  }
  #testimonials-{{ section.id }}
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1px solid #000000;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s
    , width 0.2s;
  }
  #testimonials-{{ section.id }}
  .dot.active {
    background: var(--dot-active-color);
    width: 28px;
    border-radius: 5px;
    border: none;
  }

  /* Narrow screens: one wide card via JS columns; typography tightens slightly */
  @media (max-width: 749px) {
    #testimonials-{{ section.id }} .testimonials-heading {
      font-size: 28px;
      line-height: 1.1;
      padding-inline: 4px;
    }
    #testimonials-{{ section.id }} .testimonials-subheading {
      font-size: {{ section.settings.subheading_font_size_mobile | default: 14 }}px;
      line-height: 1.43;
    }

    #testimonials-{{ section.id }}
    .testimonial-quote {
      font-size: {{ section.settings.quote_font_size | minus: 1 | at_least: 12 }}px;
    }
    #testimonials-{{ section.id }}
    .author-name {
      font-size: 12px;
    }
    #testimonials-{{ section.id }}
    .author-detail {
      font-size: 10px;
    }
  }


  /*
   Single-column carousel (carousel inner typically <560px) : match design card sizing.
   Wider tablets in the 749px breakpoint often use 2 columns — skip fixed 320 there.
*/
  @media (max-width: 559px) {
    #testimonials-{{ section.id }} .testimonial-card {
      display: flex;
      width: min(320px, 100%);
      max-width: min(320px, 100%);
      min-height: 259px;
      height: auto;
      padding: 16px;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      gap: 25px;
    }
    #testimonials-{{ section.id }}
    .testimonial-author {
      margin-top: 0;
    }
  }
</style>

<script>
  (function() {
  var root = document.getElementById('shopify-section-{{ section.id }}')
    || document.getElementById('testimonials-{{ section.id }}');
  if (!root) return;

  var track = root.querySelector('[data-track]');
  if (!track) return;

  var dotsWrap = root.querySelector('[data-dots]');
  var cards = root.querySelectorAll('.testimonial-card');
  var viewport = root.querySelector('[data-carousel]');
  var cardGapPx = {{ section.settings.card_gap }};
  var cardsPerViewMax = {{ carousel_visible }};
  var cardsPerView = cardsPerViewMax;
  var currentPage = 0;

  function totalPagesCalc() {
    if (cards.length <= cardsPerView) return 1;
    return Math.ceil(cards.length / cardsPerView);
  }
  var totalPages = totalPagesCalc();

  function carouselInnerWidth(el) {
    var cs = window.getComputedStyle(el);
    var pl = parseFloat(cs.paddingLeft) || 0;
    var pr = parseFloat(cs.paddingRight) || 0;
    var bw = el.getBoundingClientRect().width;
    return Math.max(0, bw - pl - pr);
  }

  /** Fewer columns on narrow viewports so cards stay readable (matches theme ~750 / ~990 feel). */
  function refreshCardsPerView() {
    if (!viewport) {
      cardsPerView = cardsPerViewMax;
      return;
    }
    var inner = carouselInnerWidth(viewport);
    if (inner < 560) {
      cardsPerView = 1;
    } else if (inner < 990) {
      cardsPerView = 2;
    } else {
      cardsPerView = Math.min(3, cardsPerViewMax);
    }
  }

  function renderDots() {
    if (!dotsWrap) return;
    totalPages = totalPagesCalc();
    if (totalPages <= 1) {
      dotsWrap.innerHTML = '';
      dotsWrap.setAttribute('hidden', '');
      return;
    }
    dotsWrap.removeAttribute('hidden');
    var frag = document.createDocumentFragment();
    for (var i = 0; i < totalPages; i++) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'dot' + (i === currentPage ? ' active' : '');
      b.setAttribute('data-index', String(i));
      b.setAttribute('aria-label', 'Go to testimonials page ' + (i + 1));
      frag.appendChild(b);
    }
    dotsWrap.innerHTML = '';
    dotsWrap.appendChild(frag);
  }

  if (dotsWrap) {
    dotsWrap.addEventListener('click', function(ev) {
      var t = ev.target && ev.target.closest('.dot');
      if (!t || !dotsWrap.contains(t)) return;
      ev.preventDefault();
      goToPage(parseInt(t.getAttribute('data-index'), 10));
    });
  }

  /** Px-wide columns: integer widths only so exactly `cols` fit in viewport (no fractional 4th card peek). */
  function applyColumnWidths() {
    if (!viewport || cards.length === 0) return;
    var vw = carouselInnerWidth(viewport);
    if (!(vw > 0)) return;
    var cols = cardsPerView;
    var gapBudget = ((cols - 1) * cardGapPx);
    var slot = Math.floor((vw - gapBudget) / cols);
    var maxW = cols === 1 ? 320 : 433;
    var cw = Math.min(maxW, slot);
    if (cw <= 0) return;
    viewport.style.setProperty('--t-card-col-px', cw + 'px');
    viewport.style.setProperty('--t-carousel-cols', String(cols));
  }

  /** Jump by full pages of `cardsPerView`; last page aligns to the final group of cards. */
  function translatePxForPage(pageIndex) {
    var n = cards.length;
    var cpv = cardsPerView;
    if (n === 0 || n <= cpv) return 0;
    var lastPageIdx = Math.ceil(n / cpv) - 1;
    var startCard = pageIndex >= lastPageIdx ? Math.max(0, n - cpv) : pageIndex * cpv;
    return cards[startCard].offsetLeft;
  }

  function goToPage(pageIndex) {
    if (cards.length === 0) return;
    totalPages = totalPagesCalc();
    if (pageIndex < 0) pageIndex = 0;
    if (pageIndex >= totalPages) pageIndex = Math.max(0, totalPages - 1);
    currentPage = pageIndex;
    track.style.transform = 'translateX(-' + translatePxForPage(pageIndex) + 'px)';
    if (dotsWrap) {
      dotsWrap.querySelectorAll('.dot').forEach(function(dot, i) {
        dot.classList.toggle('active', i === currentPage);
      });
    }
  }

  function syncSlideAfterLayout() {
    refreshCardsPerView();
    if (currentPage >= totalPagesCalc()) currentPage = Math.max(0, totalPagesCalc() - 1);
    renderDots();
    applyColumnWidths();
    totalPages = totalPagesCalc();
    if (currentPage >= totalPages) currentPage = Math.max(0, totalPages - 1);
    requestAnimationFrame(function() {
      refreshCardsPerView();
      renderDots();
      applyColumnWidths();
      goToPage(currentPage);
    });
  }

  if (cards.length === 0) return;

  if (typeof window.ResizeObserver !== 'undefined') {
    var ro = new ResizeObserver(function() {
      syncSlideAfterLayout();
    });
    if (viewport) ro.observe(viewport);
    else ro.observe(track);
  }
  window.addEventListener('load', syncSlideAfterLayout);
  window.addEventListener('orientationchange', syncSlideAfterLayout);
  window.addEventListener('resize', syncSlideAfterLayout);

  // Touch/swipe support
  var startX = 0;
  var isDragging = false;

  track.addEventListener('touchstart', function(e) {
    startX = e.touches[0].clientX;
    isDragging = true;
  }, { passive: true });

  track.addEventListener('touchend', function(e) {
    if (!isDragging) return;
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) {
      goToPage(currentPage + (diff > 0 ? 1 : -1));
    }
    isDragging = false;
  });

  syncSlideAfterLayout();

  // Auto-play every 5 seconds
  var autoplayInterval;
  function startAutoplay() {
    if (autoplayInterval) return;
    autoplayInterval = setInterval(function() {
      totalPages = totalPagesCalc();
      var next = currentPage + 1 >= totalPages ? 0 : currentPage + 1;
      goToPage(next);
    }, 5000);
  }
  startAutoplay();

  // Keep autoplay continuous so it always advances every 5s.
  })();
</script>

{% schema %}
  {
    "name": "Testimonials",
    "tag": "section",
    "class": "shopify-section--testimonials",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "container_width",
        "label": "Container max width (px)",
        "min": 800,
        "max": 1600,
        "step": 20,
        "default": 1200
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding top (px)",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 64
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding bottom (px)",
        "min": 0,
        "max": 120,
        "step": 4,
        "default": 64
      }, {
        "type": "range",
        "id": "cards_per_view",
        "label": "Cards visible at once",
        "min": 3,
        "max": 3,
        "step": 1,
        "default": 3,
        "info": "Shows up to 3 cards on wide screens; automatically uses 2 on tablet-width and 1 on phones so quotes stay readable."
      }, {
        "type": "range",
        "id": "card_gap",
        "label": "Gap between cards (px)",
        "min": 8,
        "max": 48,
        "step": 4,
        "default": 20
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Section background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "card_background_color",
        "label": "Card background",
        "default": "#f9f9f9"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading color",
        "default": "#111111"
      }, {
        "type": "color",
        "id": "accent_color",
        "label": "Accent / highlight color",
        "default": "#F4A319"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Quote & name text color",
        "default": "#222222"
      }, {
        "type": "color",
        "id": "subtext_color",
        "label": "Subtext / meta color",
        "default": "#888888"
      }, {
        "type": "color",
        "id": "star_color",
        "label": "Star color",
        "default": "#F4A319"
      }, {
        "type": "color",
        "id": "dot_active_color",
        "label": "Active dot color",
        "default": "#E05A1B"
      }, {
        "type": "color",
        "id": "dot_inactive_color",
        "label": "Inactive dot color",
        "default": "#D9D9D9"
      }, {
        "type": "header",
        "content": "Heading"
      }, {
        "type": "checkbox",
        "id": "show_badge",
        "label": "Show star badge above heading",
        "default": true
      }, {
        "type": "text",
        "id": "heading_highlight",
        "label": "Heading highlighted text (accent color)",
        "default": "50,000+"
      }, {
        "type": "text",
        "id": "heading",
        "label": "Heading main text",
        "default": "RIDERS CAN'T BE WRONG"
      }, {
        "type": "text",
        "id": "subheading",
        "label": "Subheading / description",
        "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit"
      }, {
        "type": "range",
        "id": "subheading_font_size",
        "label": "Subheading font size",
        "min": 12,
        "max": 24,
        "step": 1,
        "default": 16,
        "unit": "px"
      }, {
        "type": "range",
        "id": "subheading_font_size_mobile",
        "label": "Subheading font size (mobile)",
        "info": "Used below 750px screen width.",
        "min": 11,
        "max": 20,
        "step": 1,
        "default": 14,
        "unit": "px"
      }, {
        "type": "select",
        "id": "heading_font_family",
        "label": "Heading font",
        "default": "Barlow Condensed",
        "options": [
          {
            "value": "Barlow Condensed",
            "label": "Barlow Condensed"
          },
          {
            "value": "Bebas Neue",
            "label": "Bebas Neue"
          },
          {
            "value": "Montserrat",
            "label": "Montserrat"
          },
          {
            "value": "Oswald",
            "label": "Oswald"
          }, {
            "value": "Anton",
            "label": "Anton"
          }, {
            "value": "Roboto Condensed",
            "label": "Roboto Condensed"
          }
        ]
      }, {
        "type": "range",
        "id": "heading_font_size",
        "label": "Heading max font size (px)",
        "min": 32,
        "max": 96,
        "step": 2,
        "default": 54
      }, {
        "type": "header",
