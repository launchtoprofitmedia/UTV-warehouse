                        {%- endfor -%}
                      </div>
                    </div>
                  {%- endif -%}

                </div>
              </form>

            </div>{%- comment -%}/.container--flush{%- endcomment -%}

            {%- comment -%}=== YOU MAY ALSO LIKE ==={%- endcomment -%}
            {%- assign upsell_collection = section.settings.upsell_collection -%}
            {%- if upsell_collection != blank -%}
              {%- capture upsell_products -%}
                {%- assign upsell_count = 0 -%}
                {%- for product in upsell_collection.products -%}
                  {%- unless product.available -%}{%- continue -%}{%- endunless -%}
                  {%- assign include_product = true -%}
                  {%- for line_item in cart.items -%}
                    {%- if line_item.product_id == product.id -%}
                      {%- assign include_product = false -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if include_product -%}
                    {%- render 'cart-slider-product-card', product: product, show_add_to_cart: true, grid_classes: '1/3--lap 1/3--desk 1/4--wide' -%}
                    {%- assign upsell_count = upsell_count | plus: 1 -%}
                    {%- if upsell_count >= section.settings.upsell_products_count -%}{%- break -%}{%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endcapture -%}

              {%- if upsell_products != blank -%}
                {%- capture upsell_settings -%}{"stackable": false, "layout": "vertical"}{%- endcapture -%}
                <div class="container">
                  <div class="section" data-section-id="{{ section.id }}-upsell" data-section-type="featured-collection" data-section-settings='{{ upsell_settings }}'>
                    <header class="section__header">
                      <h2 class="section__title heading h3">
                        {%- if section.settings.upsell_heading != blank -%}
                          {{ section.settings.upsell_heading | escape }}
                        {%- else -%}
                          You May Also Like
                        {%- endif -%}
                      </h2>
                    </header>
                    <div class="scroller">
                      <div class="scroller__inner">
                        <div class="product-list product-list--vertical product-list--scrollable">
                          {{ upsell_products }}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>

                <div id="modal-quick-view-{{ section.id }}" class="modal" aria-hidden="true">
                  <div class="modal__dialog modal__dialog--stretch" role="dialog">
                    <div class="modal__loader">{%- render 'icon', icon: 'search-loader' -%}</div>
                    <div class="modal__inner"></div>
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}

          </div>{%- comment -%}/.cart-wrapper__inner-inner{%- endcomment -%}
        </div>{%- comment -%}/.cart-wrapper__inner{%- endcomment -%}
      </div>{%- comment -%}/.cart-wrapper{%- endcomment -%}

    {%- endif -%}

  </div>{%- comment -%}/.cart-panel[your-cart]{%- endcomment -%}

  {%- comment -%}=== RECENTLY VIEWED PANEL ==={%- endcomment -%}
  <div class="cart-panel" data-cart-panel="recently-viewed" role="tabpanel">
    <div class="container">
      <div class="section">
        <div id="cart-recently-viewed">
          <p class="cart-recently-viewed__message" id="cart-rv-empty" style="display:none">
            You haven't viewed any products yet. Browse the store and they'll appear here!
          </p>
          <div class="cart-recently-viewed__spinner" id="cart-rv-spinner" style="display:none">
            Loading recently viewed products&hellip;
          </div>
          <div class="scroller" id="cart-rv-scroller" style="display:none">
            <div class="scroller__inner">
              <div class="product-list product-list--vertical product-list--scrollable" id="cart-rv-products"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

{%- comment -%}=== TAB + RECENTLY VIEWED JAVASCRIPT ==={%- endcomment -%}
<script>
(function () {
  var section = document.querySelector('[data-section-type="cart"]');
  if (!section) return;

  /* ---- Tab switching ---- */
  var tabs   = section.querySelectorAll('[data-cart-tab]');
  var panels = section.querySelectorAll('[data-cart-panel]');

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var target = this.getAttribute('data-cart-tab');

      tabs.forEach(function (t) {
        t.classList.remove('cart-page-tab--active');
        t.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function (p) { p.classList.remove('cart-panel--active'); });

      this.classList.add('cart-page-tab--active');
      this.setAttribute('aria-selected', 'true');

      var panel = section.querySelector('[data-cart-panel="' + target + '"]');
      if (panel) panel.classList.add('cart-panel--active');

      if (target === 'recently-viewed') loadRecentlyViewed();
    });
  });

  /* ---- Recently Viewed loader ---- */
  var rvLoaded = false;

  function loadRecentlyViewed() {
    if (rvLoaded) return;
    rvLoaded = true;

    var emptyEl   = document.getElementById('cart-rv-empty');
    var spinnerEl = document.getElementById('cart-rv-spinner');
    var scrollerEl= document.getElementById('cart-rv-scroller');
    var listEl    = document.getElementById('cart-rv-products');

    /* Read IDs from localStorage (theme key: recentlyViewedProducts) */
    var ids = [];
    try { ids = JSON.parse(localStorage.getItem('recentlyViewedProducts') || '[]'); } catch (e) {}

    if (!ids.length) {
      if (emptyEl) emptyEl.style.display = 'block';
      return;
    }

    /* Show spinner */
    if (spinnerEl) spinnerEl.style.display = 'block';

    /* Build Shopify search query: id:111 OR id:222 ... */
    var query = ids.slice(0, 12).map(function (id) { return 'id:' + id; }).join(' OR ');

    /* Fetch via Shopify Sections API — renders recently-viewed-products.liquid */
    var sectionId = 'recently-viewed-products';
    var url = window.routes.searchUrl
      + '?section_id=' + encodeURIComponent(sectionId)
      + '&type=product'
      + '&q=' + encodeURIComponent(query);

    fetch(url, { credentials: 'same-origin' })
      .then(function (r) { return r.text(); })
      .then(function (html) {
        if (spinnerEl) spinnerEl.style.display = 'none';

        var tmp = document.createElement('div');
        tmp.innerHTML = html;

        var placeholder = tmp.querySelector('.recently-viewed-products-placeholder');
        if (!placeholder || placeholder.innerHTML.trim() === '') {
          if (emptyEl) emptyEl.style.display = 'block';
          return;
        }

        if (listEl) listEl.innerHTML = placeholder.innerHTML;
        if (scrollerEl) scrollerEl.style.display = 'block';

        /* Re-initialise Flickity carousel (same options as theme) */
        if (window.Flickity && listEl) {
          try {
            new window.Flickity(listEl, {
              watchCSS: true,
              pageDots: false,
              prevNextButtons: true,
              contain: true,
              resize: false,
              groupCells: true,
              cellAlign: 'left',
              draggable: !window.matchMedia('(-moz-touch-enabled: 0), (hover: hover)').matches
            });
          } catch (e) {}
        }
      })
      .catch(function () {
        if (spinnerEl) spinnerEl.style.display = 'none';
        if (emptyEl) emptyEl.style.display = 'block';
      });
  }
})();
</script>
<script>
(function () {
  var cartSection = document.querySelector('[data-section-type="cart"]');
  if (!cartSection) return;

  cartSection.addEventListener('change', function (event) {
    var select = event.target.closest('[data-cart-size-select]');
    if (!select) return;

    var button = select.parentNode.querySelector('[data-cart-slider-atc]');
    if (!button) return;

    var optionIndex = parseInt(select.getAttribute('data-option-index'), 10);
    var variants = [];

    try {
      variants = JSON.parse(select.getAttribute('data-variants') || '[]');
    } catch (e) {}

    var activeSwatch = select.parentNode.querySelector('[data-cart-swatch].is-active');
    var colorOptIdx = activeSwatch ? parseInt(activeSwatch.getAttribute('data-color-opt-idx') || '0', 10) : null;
    var colorValue = activeSwatch ? activeSwatch.getAttribute('data-color-value') : null;

    var matchedVariant = variants.find(function (variant) {
      var sizeMatches = variant['option' + (optionIndex + 1)] === select.value;
      if (colorValue === null) return sizeMatches;
      return sizeMatches && variant['option' + (colorOptIdx + 1)] === colorValue;
    });

    if (matchedVariant) {
      button.setAttribute('data-variant-id', matchedVariant.id);
      button.disabled = !matchedVariant.available;
      button.textContent = matchedVariant.available ? 'Add to Cart' : 'Sold Out';
    }
  });

  cartSection.addEventListener('click', function (event) {
    var swatch = event.target.closest('[data-cart-swatch]');
    if (!swatch) return;

    event.preventDefault();

    var card = swatch.closest('[data-cart-slider-card]');
    if (!card) return;

    card.querySelectorAll('[data-cart-swatch]').forEach(function (item) {
      item.classList.toggle('is-active', item === swatch);
    });

    var image = card.querySelector('.cart-slider-card__image img');
    var imageSrc = swatch.getAttribute('data-image-src');
    if (image && imageSrc) image.src = imageSrc;

    var button = card.querySelector('[data-cart-slider-atc]');
    var select = card.querySelector('[data-cart-size-select]');
    var swatchVariantId = swatch.getAttribute('data-variant-id');
    var soldOut = swatch.classList.contains('is-soldout');

    if (select) {
      var sizeOptIdx = parseInt(select.getAttribute('data-option-index') || '0', 10);
      var colorOptIdx = parseInt(swatch.getAttribute('data-color-opt-idx') || '0', 10);
      var colorValue = swatch.getAttribute('data-color-value');
      var variants = [];

      try {
        variants = JSON.parse(select.getAttribute('data-variants') || '[]');
      } catch (e) {}

      var matchingColorVariants = variants.filter(function (variant) {
        return variant['option' + (colorOptIdx + 1)] === colorValue;
      });

      Array.from(select.options).forEach(function (option) {
        var optionVariant = matchingColorVariants.find(function (variant) {
          return variant['option' + (sizeOptIdx + 1)] === option.value;
        });
        option.disabled = !optionVariant || !optionVariant.available;
      });

      var firstAvailable = matchingColorVariants.find(function (variant) { return variant.available; });
      var fallbackVariant = matchingColorVariants[0];
      var useVariant = firstAvailable || fallbackVariant;

      if (useVariant) {
        select.value = useVariant['option' + (sizeOptIdx + 1)];
        if (button) {
          button.setAttribute('data-variant-id', useVariant.id);
          button.disabled = !useVariant.available;
          button.textContent = useVariant.available ? 'Add to Cart' : 'Sold Out';
        }
      }
    } else if (button && swatchVariantId) {
      button.setAttribute('data-variant-id', swatchVariantId);
      button.disabled = soldOut;
      button.textContent = soldOut ? 'Sold Out' : 'Add to Cart';
    }
  });

  cartSection.addEventListener('click', function (event) {
    var button = event.target.closest('[data-cart-slider-atc]');
    if (!button || button.tagName === 'A') return;

    event.preventDefault();

    var variantId = parseInt(button.getAttribute('data-variant-id'), 10);
    if (!variantId) return;

    var originalText = button.textContent;
    button.disabled = true;
    button.textContent = 'Adding...';

    fetch(window.routes.cartAddUrl + '.js', {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1
      })
    })
    .then(function (response) {
      return response.json();
    })
    .then(function (data) {
      button.textContent = 'Added!';
      document.documentElement.dispatchEvent(
        new CustomEvent('product:added', {
          bubbles: true,
          detail: { variant: data, quantity: 1 }
        })
      );

      setTimeout(function () {
        button.disabled = false;
        button.textContent = originalText;
      }, 1500);
    })
    .catch(function () {
      button.disabled = false;
      button.textContent = originalText;
    });
  });
})();
</script>
