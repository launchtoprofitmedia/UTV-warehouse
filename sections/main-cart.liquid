{%- capture section_settings -%}
{
  "showShippingEstimator": {% if cart.item_count == 0 %}false{% else %}{{ section.settings.show_shipping_estimator | json }}{% endif %}
}
{%- endcapture -%}

{%- assign free_shipping_threshold = section.settings.free_shipping_threshold -%}
{%- if free_shipping_threshold == 0 -%}
  {%- assign free_shipping_threshold = settings.cart_free_shipping_threshold -%}
{%- endif -%}
{%- assign threshold_in_cents = free_shipping_threshold | times: 100 -%}
{%- assign remaining_cents = threshold_in_cents | minus: cart.total_price -%}
{%- assign progress_percent = cart.total_price | times: 100.0 | divided_by: threshold_in_cents | round -%}
{%- if progress_percent > 100 -%}{%- assign progress_percent = 100 -%}{%- endif -%}

<section data-section-id="{{ section.id }}" data-section-type="cart" data-section-settings='{{ section_settings }}' data-item-count="{{ cart.item_count }}">

  <style>
    /* =============================================
   CART SLIDER PRODUCT CARD
============================================= */
.cart-slider-card {
  border: 1px solid var(--border-color);
  background: var(--background);
  display: flex;
  flex-direction: column;
  height: 100%;
}

.cart-slider-card__image {
  position: relative;
  display: block;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--secondary-background);
}

.cart-slider-card__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cart-slider-card__badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--product-on-sale-accent);
  color: var(--product-on-sale-color);
  font-size: 10px;
  font-weight: 700;
  line-height: 1.3;
  padding: 4px 7px;
  border-radius: 3px;
}

.cart-slider-card__content {
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}

.cart-slider-card__title {
  font-size: 14px;
  line-height: 1.35;
  font-weight: 600;
  color: var(--text-color);
  text-decoration: none;
}

.cart-slider-card__title:hover {
  text-decoration: underline;
}

.cart-slider-card__prices {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
}

.cart-slider-card__price {
  font-size: 16px;
  font-weight: 700;
}

.cart-slider-card__price--sale {
  color: var(--product-on-sale-accent);
}

.cart-slider-card__price-compare {
  color: var(--text-color-light, var(--link-color));
  text-decoration: line-through;
  font-size: 13px;
}

.cart-slider-card__swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.cart-slider-card__swatch {
  width: 32px;
  height: 32px;
  border: 2px solid transparent;
  padding: 0;
  overflow: hidden;
  border-radius: 4px;
  background: none;
  cursor: pointer;
}

.cart-slider-card__swatch img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.cart-slider-card__swatch.is-active {
  border-color: var(--accent-color);
}

.cart-slider-card__swatch.is-soldout {
  opacity: 0.45;
}

.cart-slider-card__select {
  width: 100%;
  min-height: 40px;
  border: 1px solid var(--border-color);
  background: var(--background);
  color: var(--text-color);
  padding: 0 10px;
  font-size: 14px;
}

.cart-slider-card__button {
  width: 100%;
  margin-top: auto;
}
    /* =============================================
       FREE SHIPPING BAR
    ============================================= */
    .cart-shipping-bar {
      background: var(--secondary-background);
      border-bottom: 1px solid var(--border-color);
      padding: 10px 0 14px;
      margin-bottom: 0;
    }
    .cart-shipping-bar__message {
      font-size: 13px;
      text-align: center;
      margin: 0 0 8px;
    }
    .cart-shipping-bar__message--success {
      color: var(--success-color);
      font-weight: 600;
    }
    .cart-shipping-bar__track {
      height: 5px;
      background: var(--border-color);
      border-radius: 999px;
      overflow: hidden;
      max-width: 420px;
      margin: 0 auto;
    }
    .cart-shipping-bar__fill {
      height: 100%;
      background: var(--accent-color);
      border-radius: 999px;
      transition: width 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* =============================================
       CART PAGE TABS
    ============================================= */
    .cart-page-tabs {
      display: flex;
      border-bottom: 2px solid var(--border-color);
      margin-bottom: 32px;
      gap: 0;
    }
    .cart-page-tab {
      background: none;
      border: none;
      padding: 14px 28px;
      font-family: var(--heading-font-family);
      font-size: 16px;
      font-weight: 600;
      color: var(--text-color);
      cursor: pointer;
      position: relative;
      opacity: 0.45;
      transition: opacity 0.2s ease;
      display: flex;
      align-items: center;
      gap: 8px;
      letter-spacing: 0.01em;
    }
    .cart-page-tab:hover {
      opacity: 0.75;
    }
    .cart-page-tab--active {
      opacity: 1;
    }
    .cart-page-tab--active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--accent-color);
    }
    .cart-page-tab__badge {
      background: var(--accent-color);
      color: #fff;
      border-radius: 999px;
      padding: 1px 7px;
      font-size: 11px;
      font-weight: 700;
      min-width: 20px;
      text-align: center;
      line-height: 1.6;
    }

    /* =============================================
       CART PANELS
    ============================================= */
    .cart-panel {
      display: none;
    }
    .cart-panel--active {
      display: block;
    }

    /* =============================================
       EMPTY CART STATE
    ============================================= */
    .cart-empty {
      text-align: center;
      padding: 56px 20px 40px;
      max-width: 480px;
      margin: 0 auto;
    }
    .cart-empty__icon {
      margin-bottom: 24px;
      opacity: 0.18;
    }
    .cart-empty__icon svg {
      width: 88px;
      height: 88px;
    }
    .cart-empty__title {
      margin-bottom: 10px;
    }
    .cart-empty__description {
      color: var(--link-color);
      margin-bottom: 28px;
      font-size: 15px;
    }
    .cart-empty__cta {
      display: inline-block;
    }

    /* =============================================
       CART LAYOUT (items + sidebar)
    ============================================= */
    .cart-recap__shipping-note {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--link-color);
      padding: 10px 0 6px;
      border-top: 1px solid var(--border-color);
      margin-top: 8px;
    }
    .cart-recap__shipping-note svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
      opacity: 0.7;
    }
    .cart-recap__continue {
      display: block;
      text-align: center;
      margin-bottom: 10px;
      font-size: 13px;
      color: var(--link-color);
      text-decoration: underline;
      cursor: pointer;
      background: none;
      border: none;
      width: 100%;
      padding: 6px;
    }
    .cart-recap__continue:hover {
      color: var(--text-color);
    }
    .cart-recap__checkout-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
    }
    .cart-recap__checkout-btn svg {
      width: 16px;
      height: 16px;
      flex-shrink: 0;
    }
    .cart-recap__notices {
      font-size: 12px;
      color: var(--link-color);
      margin-bottom: 4px;
    }
    .cart-recap__notices p {
      margin: 0;
    }
    .line-item__variant {
      font-size: 12px;
      color: var(--link-color);
      margin: 2px 0;
    }

    /* =============================================
       RECENTLY VIEWED PANEL
    ============================================= */
    .cart-recently-viewed__message {
      text-align: center;
      color: var(--link-color);
      padding: 56px 20px;
      font-size: 15px;
    }
    .cart-recently-viewed__spinner {
      text-align: center;
      padding: 56px 20px;
      color: var(--link-color);
    }

    /* =============================================
       MOBILE OVERRIDES
    ============================================= */
    @media screen and (max-width: 767px) {
      .cart-page-tab {
        padding: 12px 16px;
        font-size: 14px;
      }
    }
  </style>

  {%- comment -%}=== FREE SHIPPING BAR ==={%- endcomment -%}
  {%- if threshold_in_cents > 0 -%}
    <div class="cart-shipping-bar">
      <div class="container">
        {%- if cart.total_price >= threshold_in_cents -%}
          <p class="cart-shipping-bar__message cart-shipping-bar__message--success">
            You've unlocked <strong>FREE shipping!</strong> 🎉
          </p>
        {%- else -%}
          <p class="cart-shipping-bar__message">
            You are <strong>{{ remaining_cents | money }}</strong> away from <strong>free shipping</strong>
          </p>
        {%- endif -%}
        <div class="cart-shipping-bar__track">
          <div class="cart-shipping-bar__fill" style="width: {{ progress_percent }}%"></div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}=== TAB NAVIGATION ==={%- endcomment -%}
  <div class="container">
    <div class="cart-page-tabs" role="tablist">
      <button class="cart-page-tab cart-page-tab--active" role="tab" aria-selected="true" data-cart-tab="your-cart">
        Your Cart
        {%- if cart.item_count > 0 -%}
          <span class="cart-page-tab__badge">{{ cart.item_count }}</span>
        {%- endif -%}
      </button>
      <button class="cart-page-tab" role="tab" aria-selected="false" data-cart-tab="recently-viewed">
        Recently Viewed
      </button>
    </div>
  </div>

  {%- comment -%}=== YOUR CART PANEL ==={%- endcomment -%}
  <div class="cart-panel cart-panel--active" data-cart-panel="your-cart" role="tabpanel">

    {%- if cart.item_count == 0 -%}

      {%- comment -%}--- EMPTY STATE ---{%- endcomment -%}
      <div class="container">
        <div class="cart-empty">
          <div class="cart-empty__icon">
            {%- render 'icon', icon: 'big-cart' -%}
          </div>
          <h1 class="cart-empty__title heading h2">Your Cart is Empty</h1>
          <p class="cart-empty__description">Looks like you haven't added anything yet.</p>
          <a href="{{ routes.all_products_collection_url }}" class="cart-empty__cta button button--primary button--large">Shop Now</a>
        </div>
      </div>

      {%- comment -%}--- RIDER'S RECOMMENDED PICKS ---{%- endcomment -%}
      {%- assign recommended_collection = section.settings.recommended_collection -%}
      {%- if recommended_collection != blank -%}
        {%- capture recommended_section_settings -%}{"stackable": false, "layout": "vertical"}{%- endcapture -%}

        <div class="container">
          <div class="section" data-section-id="{{ section.id }}-recommended" data-section-type="featured-collection" data-section-settings='{{ recommended_section_settings }}'>
            <header class="section__header">
              <h2 class="section__title heading h3">
                {%- if section.settings.recommended_heading != blank -%}
                  {{ section.settings.recommended_heading | escape }}
                {%- else -%}
                  Rider's Recommended Picks
                {%- endif -%}
              </h2>
            </header>

            <div class="scroller">
              <div class="scroller__inner">
                <div class="product-list product-list--vertical product-list--scrollable">
                  {%- for product in recommended_collection.products limit: section.settings.recommended_products_count -%}
                    {%- render 'cart-slider-product-card', product: product, show_add_to_cart: true, grid_classes: '1/2--lap 1/3--desk 1/4--wide' -%}
                  {%- endfor -%}
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="modal-quick-view-{{ section.id }}-recommended" class="modal" aria-hidden="true">
          <div class="modal__dialog modal__dialog--stretch" role="dialog">
            <div class="modal__loader">{%- render 'icon', icon: 'search-loader' -%}</div>
            <div class="modal__inner"></div>
          </div>
        </div>
      {%- endif -%}

    {%- else -%}

      {%- comment -%}--- CART WITH ITEMS ---{%- endcomment -%}
      <div class="cart-wrapper">
        <div class="cart-wrapper__inner">
          <div class="cart-wrapper__inner-inner">
            <div class="container container--flush">

              {%- comment -%}=== LINE ITEMS ==={%- endcomment -%}
              <div class="card">
                <div class="table-wrapper">
                  <table class="line-item-table table table--loose">
                    <thead class="hidden-phone">
                      <tr>
                        <th>{{ 'customer.order.product' | t }}</th>
                        <th class="table__cell--center">{{ 'customer.order.quantity' | t }}</th>
                        <th class="table__cell--right">{{ 'customer.order.total' | t }}</th>
                      </tr>
                    </thead>

                    <tbody>
                      {%- for line_item in cart.items -%}
                        <tr class="line-item line-item--stack">
                          <td class="line-item__product-info">
                            <div class="line-item__product-info-wrapper">
                              <div class="line-item__image-wrapper">
                                {%- if line_item.image.aspect_ratio < 1 -%}
                                  <div class="aspect-ratio aspect-ratio--square">
                                    <img src="{{ line_item.image | image_url: width: 180 }}" width="180" height="180" alt="{{ line_item.image.alt | escape }}">
                                  </div>
                                {%- else -%}
                                  <div class="aspect-ratio" style="padding-bottom: {{ 100.0 | divided_by: line_item.image.aspect_ratio }}%">
                                    <img src="{{ line_item.image | image_url: width: 180 }}" width="180" height="{{ 180 | divided_by: line_item.image.aspect_ratio | round }}" alt="{{ line_item.image.alt | escape }}">
                                  </div>
                                {%- endif -%}
                              </div>

                              <div class="line-item__meta">
                                <a href="{{ line_item.url }}" class="line-item__title link text--strong">{{ line_item.title }}</a>

                                {%- if line_item.selling_plan_allocation -%}
                                  <p class="line-item__plan-allocation">{{ line_item.selling_plan_allocation.selling_plan.name }}</p>
                                {%- endif -%}

                                {%- unless line_item.variant.title == 'Default Title' -%}
                                  <p class="line-item__variant">{{ line_item.variant.title }}</p>
                                {%- endunless -%}

                                {%- unless line_item.properties == blank -%}
                                  <ul class="line-item__property-list" role="list">
                                    {%- for property in line_item.properties -%}
                                      {%- assign first_character_in_key = property.first | truncate: 1, '' -%}
                                      {%- if property.last == blank or first_character_in_key == '_' -%}
                                        {%- continue -%}
                                      {%- endif -%}
                                      <li class="line-item__property">{{ property.first }}: {{ property.last }}</li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endunless -%}

                                <div class="line-item__price-list">
                                  {%- if line_item.original_price > line_item.final_price -%}
                                    {%- if line_item.final_price == 0 -%}
                                      <span class="line-item__price line-item__price--highlight">{{ 'cart.general.free' | t }}</span>
                                    {%- else -%}
                                      <span class="line-item__price line-item__price--highlight">{{ line_item.final_price | money }}</span>
                                    {%- endif -%}
                                    <span class="line-item__price line-item__price--compare">{{ line_item.original_price | money }}</span>
                                  {%- elsif line_item.variant.compare_at_price > line_item.variant.price -%}
                                    <span class="line-item__price line-item__price--highlight">{{ line_item.final_price | money }}</span>
                                    <span class="line-item__price line-item__price--compare">{{ line_item.variant.compare_at_price | money }}</span>
                                  {%- else -%}
                                    {%- if line_item.final_price == 0 -%}
                                      <span class="line-item__price">{{ 'cart.general.free' | t }}</span>
                                    {%- else -%}
                                      <span class="line-item__price">{{ line_item.final_price | money }}</span>
                                    {%- endif -%}
                                  {%- endif -%}
                                </div>

                                {%- if line_item.line_level_discount_allocations != blank -%}
                                  <ul class="line-item__discount-list" role="list">
                                    {%- for discount_allocation in line_item.line_level_discount_allocations -%}
                                      <li class="line-item__discount">
                                        {%- render 'icon', icon: 'sale' -%}
                                        {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                {%- endif -%}

                                {%- comment -%}Mobile quantity{%- endcomment -%}
                                <div class="line-item__quantity hidden-tablet-and-up">
                                  {%- unless line_item.product.tags contains '__gift' -%}
                                    <div class="quantity-selector">
                                      {%- assign allow_more = true -%}
                                      {%- if line_item.variant.inventory_management and line_item.variant.inventory_policy == 'deny' and line_item.quantity == line_item.variant.inventory_quantity -%}
                                        {%- assign allow_more = false -%}
                                      {%- endif -%}
                                      <button type="button" class="quantity-selector__button" data-action="decrease-quantity" data-href="{{ routes.cart_change_url }}?quantity={{ line_item.quantity | minus: 1 }}&line={{ forloop.index }}" data-quantity="{{ line_item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'cart.items.decrease_quantity' | t }}">{% render 'icon', icon: 'minus' %}</button>
                                      <input aria-label="{{ 'product.form.quantity' | t }}" class="quantity-selector__value" inputmode="numeric" data-current-value="{{ line_item.quantity }}" data-line="{{ forloop.index }}" value="{{ line_item.quantity }}" size="{{ line_item.quantity | append: '' | size | at_least: 2 }}">
                                      <button type="button" class="quantity-selector__button" data-action="increase-quantity" data-href="{{ routes.cart_change_url }}?quantity={{ line_item.quantity | plus: 1 }}&line={{ forloop.index }}" data-quantity="{{ line_item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" {% if allow_more %}aria-label="{{ 'cart.items.increase_quantity' | t }}"{% else %}disabled aria-label="{{ 'cart.items.no_more_stock' | t }}"{% endif %}>{% render 'icon', icon: 'plus' %}</button>
                                    </div>
                                  {%- else -%}
                                    <span>{{ line_item.quantity }}</span>
                                  {%- endunless -%}
                                  <a href="{{ routes.cart_change_url }}?quantity=0&line={{ forloop.index }}" data-action="decrease-quantity" data-quantity="0" data-line="{{ forloop.index }}" class="line-item__quantity-remove link">{{ 'cart.items.remove' | t }}</a>
                                </div>
                              </div>
                            </div>
                          </td>

                          {%- comment -%}Desktop quantity{%- endcomment -%}
                          <td class="line-item__quantity table__cell--center hidden-phone">
                            {%- unless line_item.product.tags contains '__gift' -%}
                              <div class="quantity-selector">
                                {%- assign allow_more = true -%}
                                {%- if line_item.variant.inventory_management and line_item.variant.inventory_policy == 'deny' and line_item.quantity == line_item.variant.inventory_quantity -%}
                                  {%- assign allow_more = false -%}
                                {%- endif -%}
                                <button type="button" class="quantity-selector__button" data-action="decrease-quantity" data-href="{{ routes.cart_change_url }}?quantity={{ line_item.quantity | minus: 1 }}&line={{ forloop.index }}" data-quantity="{{ line_item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="{{ 'cart.items.decrease_quantity' | t }}">{% render 'icon', icon: 'minus' %}</button>
                                <input aria-label="{{ 'product.form.quantity' | t }}" class="quantity-selector__value" inputmode="numeric" data-current-value="{{ line_item.quantity }}" data-line="{{ forloop.index }}" value="{{ line_item.quantity }}" size="{{ line_item.quantity | append: '' | size | at_least: 2 }}">
                                <button type="button" class="quantity-selector__button" data-action="increase-quantity" data-href="{{ routes.cart_change_url }}?quantity={{ line_item.quantity | plus: 1 }}&line={{ forloop.index }}" data-quantity="{{ line_item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" {% if allow_more %}aria-label="{{ 'cart.items.increase_quantity' | t }}"{% else %}disabled aria-label="{{ 'cart.items.no_more_stock' | t }}"{% endif %}>{% render 'icon', icon: 'plus' %}</button>
                              </div>
                            {%- else -%}
                              <span>{{ line_item.quantity }}</span>
                            {%- endunless -%}
                            <a href="{{ routes.cart_change_url }}?quantity=0&line={{ forloop.index }}" data-action="decrease-quantity" data-quantity="0" data-line="{{ forloop.index }}" class="line-item__quantity-remove link">{{ 'cart.items.remove' | t }}</a>
                          </td>

                          <td class="line-item__line-price table__cell--right hidden-phone">
                            {%- if line_item.final_line_price == 0 -%}
                              {{- 'cart.general.free' | t -}}
                            {%- else -%}
                              <span>{{ line_item.final_line_price | money }}</span>
                            {%- endif -%}
                          </td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
              </div>

              {%- comment -%}=== CART RECAP SIDEBAR ==={%- endcomment -%}
              <form class="cart-recap" method="post" action="{{ routes.cart_url }}" novalidate="novalidate" data-item-count="{{ cart.item_count }}">
                <div class="cart-recap__scroller">
                  <div class="card">
                    <div class="card__section">

                      {%- if cart.cart_level_discount_applications != blank -%}
                        {%- for discount_application in cart.cart_level_discount_applications -%}
                          <div class="cart-recap__price-line cart-recap__price-line--highlight text--pull">
                            <span class="cart-recap__price-line-label">{{ discount_application.title }}</span>
                            <span class="cart-recap__price-line-price">-{{ discount_application.total_allocated_amount | money }}</span>
                          </div>
                        {%- endfor -%}
                      {%- endif -%}

                      <div class="cart-recap__price-line text--pull">
                        <span class="cart-recap__price-line-label">{{ 'cart.general.total' | t }}</span>
                        <span class="cart-recap__price-line-price">{{ cart.total_price | money_with_currency }}</span>
                      </div>

                      {%- assign total_discount = 0 -%}
                      {%- for line_item in cart.items -%}
                        {%- if line_item.final_line_price < line_item.original_line_price -%}
                          {%- assign total_discount = total_discount | plus: line_item.total_discount -%}
                        {%- elsif line_item.variant.compare_at_price > line_item.variant.price -%}
                          {%- assign line_discount = line_item.variant.compare_at_price | minus: line_item.variant.price | times: line_item.quantity -%}
                          {%- assign total_discount = total_discount | plus: line_discount -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- for discount_application in cart.cart_level_discount_applications -%}
                        {%- assign total_discount = total_discount | plus: discount_application.total_allocated_amount -%}
                      {%- endfor -%}
                      {%- if total_discount > 0 -%}
                        {%- capture amount_saved -%}<span>{{ total_discount | money }}</span>{%- endcapture -%}
                        <span class="cart-recap__amount-saved">{{ 'cart.general.amount_saved_html' | t: amount_saved: amount_saved }}</span>
                      {%- endif -%}

                      <div class="cart-recap__notices">
                        <p>Taxes, discounts and shipping calculated at checkout</p>
                      </div>

                      <div class="cart-recap__shipping-note">
                        {%- render 'icon', icon: 'bi-fast-delivery' -%}
