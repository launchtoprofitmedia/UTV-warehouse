                      </div>

                      <input type="hidden" name="attributes[collection_products_per_page]" value="">
                      <input type="hidden" name="attributes[collection_layout]" value="">

                      <a href="{{ routes.all_products_collection_url }}" class="cart-recap__continue">Continue Shopping</a>

                      <button type="submit" name="checkout" class="button button--primary button--full button--large cart-recap__checkout-btn">
                        {%- render 'icon', icon: 'lock-2' -%}
