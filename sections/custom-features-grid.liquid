<style>
  .custom-features-grid {
    position: relative;
    margin-top: var(--custom-features-grid-margin-top, var(--section-vertical-spacing));
    margin-bottom: var(--custom-features-grid-margin-bottom, var(--section-vertical-spacing));
    overflow: hidden;
  }

  .custom-features-grid__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .custom-features-grid__bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    margin: 0;
    display: block;
    object-fit: var(--custom-features-grid-bg-fit, cover);
    object-position: center;
  }

  .custom-features-grid__bg-overlay {
    position: absolute;
    inset: 0;
  }

  .custom-features-grid__inner {
    position: relative;
    z-index: 1;
    padding: 40px;
  }

  .custom-features-grid__header {
    text-align: center;
    margin-bottom: 40px;
  }

  .custom-features-grid__eyebrow {
    display: block;
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 18px;
    color: #FFFFFF;
  }

  .custom-features-grid__heading {
    font-family: Goldman;
    font-size: 32px;
    font-style: normal;
    font-weight: 700;
    line-height: 36px;
    text-transform: uppercase;
    color: #FFFFFF;
    margin-bottom: 0px;
  }

  .custom-features-grid__subheading {
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    color: #FFFFFF;
  }

  .custom-features-grid__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .custom-features-grid__card {
    background: #ffffff;
    border-radius: 5px;
    padding: 15px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .custom-features-grid__icon {
    width: 52px;
    height: 52px;
    margin-bottom: 12px;
    object-fit: contain;
    display: block;
  }

  .custom-features-grid__icon-placeholder {
    width: 52px;
    height: 52px;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-color, #e8622a);
  }

  .custom-features-grid__icon-placeholder svg {
    width: 44px;
    height: 44px;
    fill: none;
    stroke: var(--accent-color, #e8622a);
    stroke-width: 1.5;
  }

  .custom-features-grid__card-title {
    text-align: center;
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 24px;
    color: #000000;
    margin-bottom: 0px;
    width: 60%;
  }

  .custom-features-grid__card-text {
    color:  #5F5F5F;
    font-size: 14px;
    font-style: normal;
    font-weight: 400;
    line-height: 18px;
  }

  .custom-features-grid__card-text--richtext.rte {
    text-align: inherit;
  }

  .custom-features-grid__card-text--richtext.rte > *:first-child {
    margin-top: 0;
  }

  .custom-features-grid__card-text--richtext.rte > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .custom-features-grid__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 599px) {
    .custom-features-grid__cards {
      grid-template-columns: repeat(2, 167px);
      column-gap: 10px;
      row-gap: 10px;
      justify-content: center;
    }

    .custom-features-grid__card {
      display: flex;
      box-sizing: border-box;
      width: 167px;
      height: 155px;
      padding: 15px;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 12px;
    }

    .custom-features-grid__icon {
      width: 55px;
      height: 55px;
      flex-shrink: 0;
      margin-bottom: 0;
    }

    .custom-features-grid__icon-placeholder {
      width: 55px;
      height: 55px;
      margin-bottom: 0;
      flex-shrink: 0;
    }

    .custom-features-grid__icon-placeholder svg {
      width: 46px;
      height: 46px;
    }

    .custom-features-grid__card-title {
      width: 100%;
      margin: 0;
      font-size: 14px;
      font-style: normal;
      font-weight: 700;
      line-height: 18px;
      overflow-wrap: anywhere;
    }

    .custom-features-grid__card-text {
      display: none;
    }
  }
</style>

{%- liquid
  assign bg_image = section.settings.background_image
  assign overlay_color = section.settings.overlay_color
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
  assign section_margin_top = section.settings.margin_top | default: 0
  assign section_margin_bottom = section.settings.margin_bottom | default: 0

  assign resolved_feature_cards = nil
  assign card_source = ''

  assign mf_namespace = section.settings.collection_feature_metafield_namespace | strip | default: 'custom'
  assign mf_key = section.settings.collection_feature_metafield_key | strip | default: 'feature_cards'
  assign try_collection_feature_mf = true
  if section.settings.prefer_collection_feature_metafield == false
    assign try_collection_feature_mf = false
  endif

  comment
    1) Current collection when `collection` is set (collection template / collection context).
    2) Product templates: optional handle match first; else first product collection sorted by title with data.
  endcomment
  if try_collection_feature_mf
    if collection != blank
      assign cmf = collection.metafields[mf_namespace][mf_key]
      if cmf != blank and cmf.value != blank and cmf.value.size > 0
        assign resolved_feature_cards = cmf.value
        assign card_source = 'metaobjects'
      endif
    endif

    if card_source == '' and product != blank
      assign sorted_cols = product.collections | sort: 'title'
      assign priority_handle = section.settings.priority_collection_handle | strip
      if priority_handle != blank
        for col in sorted_cols
          if col.handle == priority_handle
            assign cmfp = col.metafields[mf_namespace][mf_key]
            if cmfp != blank and cmfp.value != blank and cmfp.value.size > 0
              assign resolved_feature_cards = cmfp.value
              assign card_source = 'metaobjects'
            endif
          endif
        endfor
      endif
      if card_source == ''
        for col in sorted_cols
          assign cmfq = col.metafields[mf_namespace][mf_key]
          if card_source == '' and cmfq != blank and cmfq.value != blank and cmfq.value.size > 0
            assign resolved_feature_cards = cmfq.value
            assign card_source = 'metaobjects'
          endif
        endfor
      endif
    endif
  endif

  if card_source == '' and section.settings.feature_cards != blank and section.settings.feature_cards.size > 0
    assign resolved_feature_cards = section.settings.feature_cards
    assign card_source = 'metaobjects'
  endif

  if card_source == '' and section.blocks.size > 0
    assign card_source = 'blocks'
  endif
-%}

<section
  class="custom-features-grid"
  id="custom-features-grid-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="custom-features-grid"
  style="--custom-features-grid-margin-top: {{ section_margin_top }}px; --custom-features-grid-margin-bottom: {{ section_margin_bottom }}px; --custom-features-grid-bg-fit: {{ section.settings.background_image_fit | default: 'cover' }};">
  <div class="custom-features-grid__bg" aria-hidden="true">
    {%- if bg_image != blank -%}
      {{
        bg_image | image_url: width: 2000 | image_tag: loading: 'lazy', sizes: '100vw', widths: '800,1000,1400,1800,2000', alt: bg_image.alt
      }}
    {%- endif -%}
    <div class="custom-features-grid__bg-overlay" style="background-color: {{ overlay_color }}; opacity: {{ overlay_opacity }};"></div>
  </div>

  <div class="custom-features-grid__inner">
    <div class="container">

      {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="custom-features-grid__header">
          {%- if section.settings.eyebrow != blank -%}
            <span class="custom-features-grid__eyebrow">{{ section.settings.eyebrow | escape }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="custom-features-grid__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="custom-features-grid__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if card_source != '' -%}
        <div class="custom-features-grid__cards">
          {%- if card_source == 'metaobjects' -%}
            {%- for card in resolved_feature_cards -%}
              {%- liquid
                assign mo_icon = card.icon.value
                assign mo_title = card.title.value
                assign mo_description = card.description
              -%}
              <div class="custom-features-grid__card" data-feature-index="{{ forloop.index }}">
                {%- if mo_icon != blank -%}
                  {{
                    mo_icon
                    | image_url: width: 104
                    | image_tag: loading: 'lazy', class: 'custom-features-grid__icon', widths: '52,104', sizes: '52px', alt: mo_icon.alt
                  }}
                {%- else -%}
                  <div class="custom-features-grid__icon-placeholder">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="12" cy="12" r="9" />
                      <path d="M12 7v5l3 3" />
                    </svg>
                  </div>
                {%- endif -%}

                {%- if mo_title != blank -%}
                  <h3 class="custom-features-grid__card-title">{{ mo_title | escape }}</h3>
                {%- endif -%}

                {%- if mo_description != blank -%}
                  {%- if mo_description.type == 'rich_text_field' -%}
                    <div class="custom-features-grid__card-text custom-features-grid__card-text--richtext rte">
                      {{ mo_description | metafield_tag }}
                    </div>
                  {%- else -%}
                    <p class="custom-features-grid__card-text">{{ mo_description.value | escape | newline_to_br }}</p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <div class="custom-features-grid__card" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}
                  {{
                    block.settings.icon | image_url: width: 104 | image_tag: loading: 'lazy', class: 'custom-features-grid__icon', widths: '52,104', sizes: '52px', alt: block.settings.icon.alt
                  }}
                {%- else -%}
                  <div class="custom-features-grid__icon-placeholder">
                    <svg
                      viewBox="0 0 24 24"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true">
                      <circle
                        cx="12"
                        cy="12"
                        r="9" />
                      <path d="M12 7v5l3 3" />
                    </svg>
                  </div>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="custom-features-grid__card-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <p class="custom-features-grid__card-text">{{ block.settings.description }}</p>
                {%- endif -%}
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Custom Features Grid",
    "settings": [
      {
        "type": "header",
        "content": "Background"
      },
      {
        "type": "header",
        "content": "Spacing"
      },
      {
        "type": "range",
        "id": "margin_top",
        "label": "Margin top",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "label": "Margin bottom",
        "min": 0,
        "max": 160,
        "step": 4,
        "unit": "px",
        "default": 0
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "select",
        "id": "background_image_fit",
        "label": "Background image sizing",
        "default": "cover",
        "options": [
          {
            "value": "cover",
            "label": "Cover (fills area, crops edges)"
          },
          {
            "value": "contain",
            "label": "Contain (full image visible, may letterbox)"
          }
        ]
      },
      {
        "type": "color",
        "id": "overlay_color",
        "label": "Overlay color",
        "default": "#1a0a00"
      },
      {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Overlay opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 0
      }, {
        "type": "header",
        "content": "Heading"
      }, {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow text",
        "default": "Why this helmet?"
      }, {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Built for riders who ride everything"
      }, {
        "type": "textarea",
        "id": "subheading",
        "label": "Subheading",
        "default": "Every feature engineered for the adventure dual-sport rider — from mountain passes to muddy trails."
      },
      {
        "type": "header",
        "content": "Collection feature metafield"
      },
      {
        "type": "paragraph",
        "content": "Collection metafield `feature cards` → `custom.feature_cards` (list of metaobject refs). Metaobject definition: Feature Card → type `feature_card`. Set entries per collection."
      },
      {
        "type": "checkbox",
        "id": "prefer_collection_feature_metafield",
        "label": "Use collection metafield when set",
        "default": true,
        "info": "Read lists from Collections. Disable to rely on section picker or blocks below only."
      },
      {
        "type": "text",
        "id": "collection_feature_metafield_namespace",
        "label": "Collection metafield namespace",
        "default": "custom",
        "info": "Settings → Custom data → Metafields → Collections."
      },
      {
        "type": "text",
        "id": "collection_feature_metafield_key",
        "label": "Collection metafield key",
        "default": "feature_cards",
        "info": "List of metaobject refs → definition `feature_card`."
      },
      {
        "type": "text",
        "id": "priority_collection_handle",
        "label": "Preferred collection handle (optional)",
        "info": "On product pages only: try this collection first (URL handle). If empty, first alphabetical collection with this metafield wins."
      },
      {
        "type": "header",
        "content": "Section fallback metaobjects"
      },
      {
        "type": "paragraph",
        "content": "When collection metafield is empty/disabled: pick Feature Card entries below. Fields: icon, title, description on type `feature_card`."
      },
      {
        "type": "metaobject_list",
        "id": "feature_cards",
        "label": "Feature cards (section)",
        "metaobject_type": "feature_card",
        "limit": 12
      }
    ],
    "blocks": [
      {
        "type": "feature_item",
        "name": "Feature item",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon image"
          }, {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Certified Safe — Full Stop"
          }, {
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "DOT and ECE certified. Dual-density EPS liner absorbs impact progressively, keeping your head protected across a range of crash forces."
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Custom Features Grid",
        "category": "Content",
        "blocks": [
          {
            "type": "feature_item",
            "settings": {
              "title": "Certified Safe — Full Stop",
              "description": "DOT (FMVSS 218) and ECE certified. Dual-density EPS liner absorbs impact progressively, keeping your head protected across a range of crash forces — not just the test standard minimum."
            }
          },
          {
            "type": "feature_item",
            "settings": {
              "title": "See Everything, Fog Nothing",
              "description": "Anti-fog, anti-scratch face shield with tool-less changes. Integrated drop-down sunshade means you stop fumbling with sunglasses mid-trail. Shield lock stays secure on rough terrain."
            }
          },
          {
            "type": "feature_item",
            "settings": {
              "title": "Cool When You Need It, Sealed When You Don't",
              "description": "Switchable ventilation in chin bar, brow, and rear. Dial it open for blazing summer trails, sealed tight for cold high-altitude passes. Works in both configs without removing the helmet."
            }
          },
          {
            "type": "feature_item",
            "settings": {
              "title": "Goggle-Ready for Off-Road Missions",
              "description": "Wide eyeport fits most standard MX goggles. 100% UVA/B protection up to 400nm. Side-plate covers convert it to street-legal in seconds — one helmet, two worlds."
            }
          }, {
            "type": "feature_item",
            "settings": {
              "title": "Fresh After Every Ride",
              "description": "Removable, washable SpaSoft antimicrobial liner. Moisture-wicking, odor-resistant. Take it out after a long ride, toss it in the wash. No more funky helmet smell by mid-season."
            }
          }, {
            "type": "feature_item",
            "settings": {
              "title": "Visible at Dawn & Dusk",
              "description": "3M reflective details integrated into the conceal pattern graphics. Low-profile enough to blend into the trail — visible enough for early morning and evening rides on the road."
            }
          }
        ]
      }
    ]
  }
{% endschema %}