<section class="section" data-section-id="{{ section.id }}" data-section-type="mosaic">
  <div class="container">
    {%- capture horizontal_blocks -%}{%- endcapture -%}
    {%- for block in section.blocks -%}
      {%- capture block_capture -%}
        <div class="mosaic__item">
          <a {% if block.settings.link %}href="{{ block.settings.link }}"{% endif %} id="block-{{ block.id }}" class="promo-block promo-block--{{ block.settings.content_position | replace: '_', '-' }} {% if block.settings.show_overlay %}promo-block--overlay{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              {%- capture bgset -%}{{ block.settings.image | img_url: '400x' }} 400w, {{ block.settings.image | img_url: '600x' }} 600w, {{ block.settings.image | img_url: '800x' }} 800w, {{ block.settings.image | img_url: '1000x' }} 1000w, {{ block.settings.image | img_url: '1200x' }} 1200w{%- endcapture -%}
            {%- endif -%}

            <div class="promo-block__image-clip">
              <div class="promo-block__image-wrapper promo-block__image-wrapper--cover lazyload image--fade-in" {% if block.settings.image %}data-bgset="{{ bgset }}" data-sizes="auto"{% endif %}>
                {%- unless block.settings.image -%}
                  <div class="placeholder-background">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {%- endunless -%}
              </div>
            </div>

            <div class="promo-block__inner">
              {%- if block.settings.title != blank -%}
                <p class="promo-block__heading heading h3">{{ block.settings.title | escape }}</p>
              {%- endif -%}

              {%- assign count_collection = block.settings.collection -%}
              {%- if count_collection == blank and block.settings.link contains '/collections/' -%}
                {%- assign linked_collection_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first -%}
                {%- assign linked_collection = collections[linked_collection_handle] -%}
                {%- if linked_collection != blank -%}
                  {%- assign count_collection = linked_collection -%}
                {%- endif -%}
              {%- endif -%}

              {%- if count_collection != blank -%}
                <p class="promo-block__content promo-block__content--count">
                  {{ count_collection.all_products_count }}
                  ({{ count_collection.all_products_count | pluralize: 'Product', 'Products' }})
                </p>
              {%- elsif block.settings.title != blank -%}
                <p class="promo-block__content">{{ block.settings.content | escape | newline_to_br }}</p>
              {%- endif -%}

              {%- if block.settings.link != blank and block.settings.button_text != blank -%}
                <span class="promo-block__cta button button--floating">{{ block.settings.button_text | escape }}</span>
              {%- endif -%}
            </div>

            <style>
              #block-{{ block.id }} {
                background-color: {{ block.settings.background }};
                color: {{ block.settings.text_color }}
              }

              #block-{{ block.id }} .button {
                background: {{ block.settings.button_background }};
                color: {{ block.settings.button_text_color }};
              }

              {%- if block.settings.show_overlay -%}
                #block-{{ block.id }}.promo-block--overlay::before {
                  {%- assign overlay_opacity = block.settings.overlay_opacity | divided_by: 100.0 -%}
                  background: linear-gradient(to top, rgba(0, 0, 0, 0) 15%, {{ '#000000' | color_modify: 'alpha', overlay_opacity }});
                }
              {%- endif -%}
            </style>

            {%- if block.settings.image -%}
              <noscript>
                <style>
                  #block-{{ block.id }} .promo-block__image-wrapper {
                    background-image: url({{ block.settings.image | img_url: '800x' }});
                  }
                </style>
              </noscript>
            {%- endif -%}
          </a>
        </div>
      {%- endcapture -%}

      {%- if forloop.index == 1 -%}
        {%- capture block_1 -%}{{ block_capture }}{%- endcapture -%}
      {%- elsif forloop.index == 2 -%}
        {%- capture block_2 -%}{{ block_capture }}{%- endcapture -%}
      {%- elsif forloop.index == 3 -%}
        {%- capture block_3 -%}{{ block_capture }}{%- endcapture -%}
      {%- elsif forloop.index == 4 -%}
        {%- capture block_4 -%}{{ block_capture }}{%- endcapture -%}
      {%- elsif forloop.index == 5 -%}
        {%- capture block_5 -%}{{ block_capture }}{%- endcapture -%}
      {%- endif -%}

      {%- capture horizontal_blocks -%}{{ horizontal_blocks }}{{ block_capture }}{%- endcapture -%}
    {%- endfor -%}

    {%- comment -%}We have accumulated all the different blocks, so now we simply create the columns based on the number of blocks{%- endcomment -%}

    {%- if section.settings.horizontal_layout -%}
      <div class="mosaic mosaic--{{ section.settings.section_size }} mosaic--horizontal-only">
        {{ horizontal_blocks }}
      </div>
      {%- if section.blocks.size > 1 -%}
        <div class="mosaic__mobile-pagination" data-mosaic-pagination>
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="mosaic__mobile-dot{% if forloop.first %} is-active{% endif %}"
              data-mosaic-dot="{{ forloop.index0 }}"
              aria-label="Go to slide {{ forloop.index }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="mosaic mosaic--{{ section.settings.section_size }} mosaic--{% if section.blocks.size == 1 %}one-column{% elsif section.blocks.size == 2 %}two-columns{% else %}three-columns{% endif %}">
        {%- case section.blocks.size -%}
          {%- when 1 or '1' -%}
            <div class="mosaic__column">
              {{ block_1 }}
            </div>

          {%- when 2 -%}
            <div class="mosaic__column">
              {{ block_1 }}
            </div>

            <div class="mosaic__column">
              {{ block_2 }}
            </div>

          {%- when 3 -%}
            <div class="mosaic__column">
              {{ block_1 }}
            </div>

            <div class="mosaic__column">
              {{ block_2 }}
            </div>

            <div class="mosaic__column">
              {{ block_3 }}
            </div>

          {%- when 4 -%}
            <div class="mosaic__column">
              {{ block_1 }}
            </div>

            <div class="mosaic__column">
              {{ block_2 }}
            </div>

            <div class="mosaic__column">
              {{ block_3 }}
              {{ block_4 }}
            </div>

          {%- when 5 -%}
            <div class="mosaic__column">
              {{ block_1 }}
              {{ block_2 }}
            </div>

            <div class="mosaic__column">
              {{ block_3 }}
            </div>

            <div class="mosaic__column">
              {{ block_4 }}
              {{ block_5 }}
            </div>
        {%- endcase -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} > .section[data-section-type="mosaic"] {
    margin-top: 10px !important;
  }
</style>

{%- if section.settings.horizontal_layout -%}
  <style>
    #shopify-section-{{ section.id }} .mosaic--horizontal-only {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 4px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      cursor: grab;
    }

    #shopify-section-{{ section.id }} .mosaic--horizontal-only::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .mosaic--horizontal-only.is-dragging {
      cursor: grabbing;
    }

    #shopify-section-{{ section.id }} .mosaic--horizontal-only.is-dragging .promo-block {
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .mosaic--horizontal-only .mosaic__item {
      flex: 0 0 276px;
      width: 276px;
    }

    #shopify-section-{{ section.id }} .mosaic--horizontal-only .promo-block {
      width: 100%;
      min-height: 322px;
      height: 322px;
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .mosaic--horizontal-only {
        justify-content: center;
      }
    }

    #shopify-section-{{ section.id }} .mosaic__mobile-pagination {
      display: none;
    }

    @media screen and (max-width: 640px) {
      #shopify-section-{{ section.id }} .mosaic--horizontal-only {
        gap: 20px;
      }

      #shopify-section-{{ section.id }} .mosaic__mobile-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        position: relative;
        z-index: 2;
        pointer-events: auto;
        padding-top: 20px;
      }

      #shopify-section-{{ section.id }} .mosaic__mobile-dot {
        width: 20px;
        height: 20px;
        border: 0;
        border-radius: 999px;
        background: #c5c7cc;
        padding: 0;
        cursor: pointer;
        pointer-events: auto;
        touch-action: manipulation;
        transition: width 0.2s ease, background-color 0.2s ease;
      }

      #shopify-section-{{ section.id }} .mosaic__mobile-dot.is-active {
        width: 50px;
        background: #d15327;
      }
    }
  </style>

  <script>
    (function() {
      var section = document.getElementById('shopify-section-{{ section.id }}');

      if (!section) {
        return;
      }

      var track = section.querySelector('.mosaic--horizontal-only');
      var pagination = section.querySelector('[data-mosaic-pagination]');
      var dots = pagination ? pagination.querySelectorAll('[data-mosaic-dot]') : [];

      if (!track) {
        return;
      }

      var isDragging = false;
      var dragMoved = false;
      var startX = 0;
      var startScrollLeft = 0;
      var DRAG_THRESHOLD = 6;

      function onPointerDown(event) {
        if (event.pointerType === 'mouse' && event.button !== 0) {
          return;
        }

        isDragging = true;
        dragMoved = false;
        startX = event.clientX;
        startScrollLeft = track.scrollLeft;
        track.classList.add('is-dragging');

        if (track.setPointerCapture) {
          track.setPointerCapture(event.pointerId);
        }
      }

      function onPointerMove(event) {
        if (!isDragging) {
          return;
        }

        var deltaX = event.clientX - startX;

        if (Math.abs(deltaX) > DRAG_THRESHOLD) {
          dragMoved = true;
        }

        track.scrollLeft = startScrollLeft - deltaX;
      }

      function endDrag() {
        isDragging = false;
        track.classList.remove('is-dragging');
      }

      function updatePagination() {
        if (!dots.length) {
          return;
        }

        var items = track.querySelectorAll('.mosaic__item');

        if (!items.length) {
          return;
        }

        var activeIndex = 0;
        var closestDistance = Infinity;
        var currentScroll = track.scrollLeft;

        items.forEach(function(item, index) {
          var distance = Math.abs(item.offsetLeft - currentScroll);

          if (distance < closestDistance) {
            closestDistance = distance;
            activeIndex = index;
          }
        });

        dots.forEach(function(dot, index) {
          var isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-current', isActive ? 'true' : 'false');
        });
      }

      track.addEventListener('pointerdown', onPointerDown);
      track.addEventListener('pointermove', onPointerMove);
      track.addEventListener('pointerup', endDrag);
      track.addEventListener('pointercancel', endDrag);
      track.addEventListener('scroll', updatePagination, { passive: true });
      window.addEventListener('resize', updatePagination);

      dots.forEach(function(dot) {
        function handleDotPress(event) {
          event.preventDefault();
          event.stopPropagation();

          var index = parseInt(dot.getAttribute('data-mosaic-dot'), 10);
          var items = track.querySelectorAll('.mosaic__item');

          if (isNaN(index) || !items[index]) {
            return;
          }

          dragMoved = false;
          track.scrollTo({ left: items[index].offsetLeft, behavior: 'smooth' });
        }

        dot.addEventListener('click', handleDotPress);
        dot.addEventListener('touchstart', handleDotPress, { passive: false });
      });

      track.addEventListener(
        'click',
        function(event) {
          if (!dragMoved) {
            return;
          }

          event.preventDefault();
          event.stopPropagation();
          dragMoved = false;
        },
        true
      );

      updatePagination();
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Mosaic",
  "max_blocks": 5,
  "settings": [
    {
      "type": "select",
      "id": "section_size",
      "label": "Section height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "horizontal_layout",
      "label": "Horizontal layout only",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "800 x 520px .jpg recommended for standard images. 1100 x 1100px .jpg recommended for center images."
        },
        {
          "type": "checkbox",
          "id": "show_overlay",
          "label": "Show overlay",
          "info": "Increase text readability on busy images.",
          "default": false
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "color",
          "id": "background",
          "label": "Background",
          "default": "#f3f4f4"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text",
          "default": "#4f5558"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Your heading"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Text",
          "default": "Tell more about your product, collection..."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection for product count"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "top_left",
              "label": "Top left"
            },
            {
              "value": "top_center",
              "label": "Top center"
            },
            {
              "value": "top_right",
              "label": "Top right"
            },
            {
              "value": "middle_left",
              "label": "Middle left"
            },
            {
              "value": "middle_center",
              "label": "Middle center"
            },
            {
              "value": "middle_right",
              "label": "Middle right"
            },
            {
              "value": "bottom_left",
              "label": "Bottom left"
            },
            {
              "value": "bottom_center",
              "label": "Bottom center"
            },
            {
              "value": "bottom_right",
              "label": "Bottom right"
            }
          ],
          "default": "top_left"
        },
        {
          "type": "header",
          "content": "Button"
        },
        {
          "type": "color",
          "id": "button_background",
          "label": "Background",
          "default": "#4f5558"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Text",
          "default": "#f3f4f4"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Text",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "category": "Image",
      "name": "Mosaic",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
