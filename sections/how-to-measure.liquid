{% comment %}
  Section: How to Measure Product
  A full-width banner section with configurable steps, background, and images.
{% endcomment %}

<section
  id="how-to-measure-{{ section.id }}"
  class="how-to-measure"
  style="
    background-color: {{ section.settings.background_color }};
    {% if section.settings.background_image != blank %}
      background-image: url('{{ section.settings.background_image | image_url: width: 3840 }}');
      background-size: cover;
      background-position: {{ section.settings.bg_position }};
    {% endif %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <div class="how-to-measure__inner">

    {%- comment -%} LEFT: Steps Panel {%- endcomment -%}
    <div class="how-to-measure__panel" style="
        background-color: {{ section.settings.panel_bg_color }};
        border: {{ section.settings.panel_border_width }}px solid {{ section.settings.panel_border_color }};
        border-radius: {{ section.settings.panel_border_radius }}px;
      ">
      {%- if section.settings.heading != blank -%}
        <h2 class="how-to-measure__heading" style="
            color: {{ section.settings.heading_color }};
            font-size: {{ section.settings.heading_font_size }}px;
          ">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      <div class="how-to-measure__steps">
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            <div
              class="how-to-measure__step"
              {{ block.shopify_attributes }}
              style="
                border-bottom: 1px solid {{ section.settings.step_divider_color }};
              ">
              {%- if block.settings.step_label != blank -%}
                <p class="how-to-measure__step-label" style="color: {{ block.settings.label_color }};">
                  {{ block.settings.step_label }}
                </p>
              {%- endif -%}

              {%- if block.settings.step_text != blank -%}
                <p class="how-to-measure__step-text" style="color: {{ block.settings.text_color }};">
                  {{ block.settings.step_text }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

    </div>

    {%- comment -%} RIGHT: Product / Lifestyle Images {%- endcomment -%}
    <div class="how-to-measure__images">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_image' -%}
          {%- if block.settings.image != blank -%}
            <div
              class="how-to-measure__img-wrap how-to-measure__img-wrap--{{ block.settings.position }}"
              {{ block.shopify_attributes }}
              style="
                width: {{ block.settings.image_width }}%;
                top: {{ block.settings.image_top }}%;
                right: {{ block.settings.image_right }}%;
              ">
              <img
                src="{{ block.settings.image | image_url: width: 2400 }}"
                alt="{{ block.settings.image_alt | escape }}"
                loading="lazy"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}">
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

<style>
  #how-to-measure-{{ section.id }} {
    --panel-max-width: {{ section.settings.panel_max_width }}px;
    --section-min-height: {{ section.settings.section_min_height }}px;
  }

  .how-to-measure {
    width: 100%;
    min-height: var(--section-min-height, 360px);
    background-repeat: no-repeat;
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
  }

  .how-to-measure__inner {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    margin: 0 auto;
    padding: 0 {{ section.settings.horizontal_padding }}px;
    gap: 40px;
    position: relative;
    z-index: 2;
    min-height: var(--section-min-height, 360px);
  }

  /* ---- Panel ---- */
  .how-to-measure__panel {
    display: flex;
    width: 567px;
    height: 518px;
    padding: 39px 34px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    margin-right: auto;
    box-sizing: border-box;
  }

  .how-to-measure__heading {
    font-family: Goldman;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 27px;
    text-transform: uppercase;
    color: #FFF;
  }

  .how-to-measure__steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .how-to-measure__step {
    padding: 14px 0;
  }

  .how-to-measure__step:last-child {
    border-bottom: none !important;
  }

  .how-to-measure__step-label {
    font-size: 16px;
    font-style: normal;
    font-weight: 700;
    line-height: 24px;
    color: #FFF;
  }

  .how-to-measure__step-text {
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: 24px;
    color: #C5C5C5;
  }

  /* ---- Images ---- */
  .how-to-measure__images {
    flex: 1 1 auto;
    position: relative;
    min-height: var(--section-min-height, 360px);
  }

  .how-to-measure__img-wrap {
    position: absolute;
  }

  .how-to-measure__img-wrap img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .how-to-measure__inner {
      flex-direction: column;
      padding: 24px</style>

