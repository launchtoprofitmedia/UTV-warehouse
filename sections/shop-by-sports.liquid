{% schema %}
{
  "name": "Shop By Sport",
  "tag": "section",
  "class": "shop-by-sport-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "FIND YOUR RIDE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP BY SPORT"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick your discipline and find gear built for exactly how you ride."
    }
  ],
  "blocks": [
    {
      "type": "sport_card",
      "name": "Sport Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Sport Title",
          "default": "MX/ENDURO"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Lorem ipsum dolor sit amet, consectetur adipiscing elit"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA Label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop By Sport",
      "blocks": [
        {
          "type": "sport_card",
          "settings": {
            "title": "MX/ENDURO",
            "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "sport_card",
          "settings": {
            "title": "BMX/MTB",
            "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "sport_card",
          "settings": {
            "title": "COLD-WEATHER RIDING GEAR",
            "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
            "cta_label": "SHOP BIBS, JACKETS, HELMETS"
          }
        },
        {
          "type": "sport_card",
          "settings": {
            "title": "STREET",
            "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "sport_card",
          "settings": {
            "title": "CASUAL",
            "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
            "cta_label": "SHOP NOW"
          }
        },
        {
          "type": "sport_card",
          "settings": {
            "title": "TIRES/WHEELS",
            "description": "Lorem ipsum dolor sit amet, consectetur adipiscing elit",
            "cta_label": "SHOP NOW"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .sbs-section {
    padding: 48px 20px;
    background: #fff;
    font-family: 'Arial Black', Arial, sans-serif;
  }

  .sbs-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .sbs-eyebrow {
    display: block;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #D15327;
    text-transform: uppercase;
    margin-bottom: 6px;
    font-family: Helvetica;
  }

  .sbs-heading {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 700;
    text-transform: uppercase;
    color: #111;
    letter-spacing: 0.04em;
    margin: 0 0 10px;
    line-height: 1.05;
    font-family: Goldman;
  }

  .sbs-subheading {
    font-size: 15px;
    font-weight: 400;
    color: #555;
    font-family: Arial, sans-serif;
    margin: 0;
    line-height: 1.5;
  }

  .sbs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    max-width: 1440px;
    margin: 0 auto;
  }

  .sbs-card {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    aspect-ratio: 4 / 3;
    background: #1a1a1a;
    cursor: pointer;
  }

  .sbs-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.08) 0%,
      rgba(0,0,0,0.18) 40%,
      rgba(0,0,0,0.72) 100%
    );
    z-index: 1;
    transition: background 0.3s ease;
  }

  .sbs-card:hover::after {
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.15) 0%,
      rgba(0,0,0,0.28) 40%,
      rgba(0,0,0,0.82) 100%
    );
  }

  .sbs-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.45s ease;
  }

  .sbs-card:hover img {
    transform: scale(1.04);
  }

  .sbs-card-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 18px 18px 20px;
  }

  .sbs-card-top {
    flex: 1;
  }

  .sbs-card-title {
    font-size: clamp(14px, 1.5vw, 19px);
    font-weight: 900;
    text-transform: uppercase;
    color: #D15327;
    letter-spacing: 0.06em;
    margin: 0 0 6px;
    line-height: 1.15;
    font-family: Goldman;
  }

  .sbs-card-desc {
    font-size: clamp(11px, 1vw, 13px);
    color: rgba(255,255,255,0.88);
    font-family: Arial, sans-serif;
    font-weight: 400;
    line-height: 1.45;
    margin: 0;
    max-width: 220px;
  }

  .sbs-card-cta {
    font-family: Helvetica; 
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: clamp(11px, 1vw, 13px);
    font-weight: 800;
    text-transform: uppercase;
    color: #fff;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: gap 0.2s ease;
    font-size: 14px;
  }

  .sbs-card:hover .sbs-card-cta {
    gap: 13px;
  }

  .sbs-card-cta svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .sbs-mobile-slider {
    display: none;
  }

  @media (max-width: 767px) {
    .sbs-section {
      padding: 36px 0 40px;
    }

    .sbs-header {
      padding: 0 20px;
      margin-bottom: 24px;
    }

    .sbs-grid {
      display: none;
    }

    .sbs-mobile-slider {
      display: block;
      position: relative;
    }

    .sbs-slider-track-wrapper {
      overflow: hidden;
      width: 100%;
    }

    .sbs-slider-track {
      display: flex;
      transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
      will-change: transform;
    }

    .sbs-slide {
      min-width: calc(100% - 40px);
      margin: 0 8px;
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      aspect-ratio: 4 / 3.2;
      background: #1a1a1a;
      flex-shrink: 0;
    }

    .sbs-slide:first-child {
      margin-left: 20px;
    }

    .sbs-slide:last-child {
      margin-right: 20px;
    }

    .sbs-slide::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.06) 0%,
        rgba(0,0,0,0.2) 40%,
        rgba(0,0,0,0.75) 100%
      );
      z-index: 1;
    }

    .sbs-slide img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .sbs-slide .sbs-card-content {
      border-radius: 4px;
    }

    .sbs-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
    }

    .sbs-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #ccc;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: background 0.2s, transform 0.2s;
    }

    .sbs-dot.active {
      background: #D15327;
      transform: scale(1.25);
    }
  }

  @media (max-width: 959px) and (min-width: 768px) {
    .sbs-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<section class="sbs-section">
  <div class="sbs-header">
    <span class="sbs-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="sbs-heading">{{ section.settings.heading }}</h2>
    <p class="sbs-subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="sbs-grid">
    {% for block in section.blocks %}
      {% if block.type == 'sport_card' %}
       <a 
          class="sbs-card"
          href="{{ block.settings.cta_url | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
          {% else %}
            <img src="{{ 'no-image.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy" />
          {% endif %}
          <div class="sbs-card-content">
            <div class="sbs-card-top">
              <p class="sbs-card-title">{{ block.settings.title }}</p>
              <p class="sbs-card-desc">{{ block.settings.description }}</p>
            </div>
            <span class="sbs-card-cta">
              {{ block.settings.cta_label }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </span>
          </div>
        </a>
      {% endif %}
    {% endfor %}
  </div>

  <div class="sbs-mobile-slider">
    <div class="sbs-slider-track-wrapper">
      <div class="sbs-slider-track" id="sbsTrack">
        {% for block in section.blocks %}
          {% if block.type == 'sport_card' %}
            
            <a  class="sbs-slide"
              href="{{ block.settings.cta_url | default: '#' }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.image %}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.title }}
              {% else %}
                <img src="{{ 'no-image.png' | asset_url }}" alt="{{ block.settings.title }}" loading="lazy" />
              {% endif %}
              <div class="sbs-card-content">
                <div class="sbs-card-top">
                  <p class="sbs-card-title">{{ block.settings.title }}</p>
                  <p class="sbs-card-desc">{{ block.settings.description }}</p>
                </div>
                <span class="sbs-card-cta">
                  {{ block.settings.cta_label }}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"/>
                    <polyline points="12 5 19 12 12 19"/>
                  </svg>
                </span>
              </div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="sbs-dots" id="sbsDots"></div>
  </div>
</section>

<script>
(function () {
  var track = document.getElementById('sbsTrack');
  var dotsContainer = document.getElementById('sbsDots');
  if (!track || !dotsContainer) return;

  var slides = track.querySelectorAll('.sbs-slide');
  var total = slides.length;
  var current = 0;
  var startX = 0;
  var isDragging = false;

  for (var i = 0; i < total; i++) {
    var dot = document.createElement('button');
    dot.className = 'sbs-dot' + (i === 0 ? ' active' : '');
    dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
    dot.dataset.index = i;
    dot.addEventListener('click', function () {
      goTo(parseInt(this.dataset.index));
    });
    dotsContainer.appendChild(dot);
  }

  function goTo(index) {
    current = Math.max(0, Math.min(index, total - 1));
    var slideWidth = slides[0].offsetWidth + 16;
    track.style.transform = 'translateX(-' + (current * slideWidth) + 'px)';
    var dots = dotsContainer.querySelectorAll('.sbs-dot');
    dots.forEach(function (d, i) {
      d.classList.toggle('active', i === current);
    });
  }

  track.addEventListener('touchstart', function (e) {
    startX = e.touches[0].clientX;
    isDragging = true;
  }, { passive: true });

  track.addEventListener('touchend', function (e) {
    if (!isDragging) return;
    var diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 40) {
      goTo(diff > 0 ? current + 1 : current - 1);
    }
    isDragging = false;
  }, { passive: true });

  window.addEventListener('resize', function () { goTo(current); });
})();
</script>