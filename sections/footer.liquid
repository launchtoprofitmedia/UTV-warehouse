{% assign logo = section.settings.logo %}
{% assign logo_width = section.settings.logo_width | default: 180 %}
{% assign description = section.settings.description %}
{% assign follow_text = section.settings.follow_text | default: 'FOLLOW US' %}
{% assign facebook_url = section.settings.facebook_url %}
{% assign instagram_url = section.settings.instagram_url %}
{% assign col2_heading = section.settings.col2_heading | default: 'SHOP' %}
{% assign col2_menu = section.settings.col2_menu %}
{% assign col3_heading = section.settings.col3_heading | default: 'INFORMATION' %}
{% assign col3_menu = section.settings.col3_menu %}
{% assign col4_heading = section.settings.col4_heading | default: 'ACCOUNT' %}
{% assign col4_menu = section.settings.col4_menu %}
{% assign col5_heading = section.settings.col5_heading | default: 'POLICY' %}
{% assign col5_menu = section.settings.col5_menu %}
{% assign payment_label = section.settings.payment_label | default: 'Accepted payment method' %}
{% assign show_payment_icons = section.settings.show_payment_icons %}
{% assign phone_number = section.settings.phone_number %}
{% assign email_address = section.settings.email_address %}
{% assign copyright_text = section.settings.copyright_text %}
{% assign bottom_text = section.settings.bottom_text %}
{% assign bg_color = section.settings.bg_color | default: '#0d0d0d' %}
{% assign text_color = section.settings.text_color | default: '#ffffff' %}
{% assign heading_color = section.settings.heading_color | default: '#ffffff' %}
{% assign link_color = section.settings.link_color | default: '#cccccc' %}
{% assign icon_bg_color = section.settings.icon_bg_color | default: '#D15327' %}
{% assign accordion_active_color = section.settings.accordion_active_color | default: '#D15327' %}

<style>
  .cf-footer {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    font-family: Arial, Helvetica, sans-serif;
    padding: 60px 40px 0 40px;
  }

  .cf-footer > .cf-top-grid,
  .cf-footer > .cf-divider,
  .cf-footer > .cf-mid-section,
  .cf-footer > .cf-bottom-section {
    max-width: 1440px;
    margin-right: auto;
    margin-left: auto;
  }

  .cf-footer a {
    color: {{ link_color }};
    text-decoration: none;
  }

  .cf-footer a:hover {
    color: {{ text_color }};
  }

  .cf-top-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1fr 1fr 1fr;
    gap: 40px;
    padding-bottom: 40px;
  }

  .cf-col-logo .cf-logo img {
    width: {{ logo_width }}px;
    height: auto;
    display: block;
  }

  .cf-col-logo .cf-description {
    font-size: 14px;
    line-height: 1.6;
    color: {{ link_color }};
    margin: 18px 0 20px 0;
    max-width: 280px;
  }

  .cf-follow-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }

  .cf-follow-label {
    font-size: 13px;
    font-weight: 700;
    color: {{ text_color }};
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .cf-social-icons {
    display: flex;
    gap: 8px;
  }

  .cf-social-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: {{ icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
  }

  .cf-social-icon:hover {
    opacity: 0.8;
  }

  .cf-social-icon svg {
    width: 18px;
    height: 18px;
    fill: #ffffff;
  }

  .cf-nav-col .cf-nav-heading {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: {{ heading_color }};
    margin: 0 0 18px 0;
    text-transform: uppercase;
  }

  .cf-nav-col .cf-nav-heading.desktop-heading {
    color: var(--White, #FFF);
    font-family: Helvetica, Arial, sans-serif;
    font-size: 20px;
    font-style: normal;
    font-weight: 700;
    line-height: 28px;
  }

  .cf-nav-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cf-nav-col ul li {
    margin-bottom: 10px;
    line-height: normal;
  }

  .cf-nav-col ul li a {
    font-size: 14px;
    color: #C5C5C5;
  }

  .cf-divider {
    border: none;
    border-top: 1px solid rgba(255,255,255,0.1);
    margin: 0;
  }

  .cf-mid-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    padding: 30px 0;
  }

  .cf-mid-left .cf-payment-label {
    font-size: 13px;
    color: {{ link_color }};
    margin-bottom: 12px;
    display: block;
  }

  .cf-payment-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .cf-payment-icons img {
    height: 28px;
    border-radius: 3px;
  }

  .cf-mid-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
  }

  .cf-contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cf-contact-icon {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background-color: {{ icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .cf-contact-icon svg {
    width: 20px;
    height: 20px;
  }

  .cf-contact-info .cf-contact-label {
    font-size: 13px;
    color: {{ link_color }};
    display: block;
  }

  .cf-contact-info .cf-contact-value {
    font-size: 14px;
    font-weight: 600;
    color: {{ text_color }};
    display: block;
    margin-top: 2px;
  }

  .cf-bottom-section {
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 20px 0;
    text-align: center;
  }

  .cf-bottom-section p {
    margin: 4px 0;
    font-size: 13px;
    color: {{ link_color }};
  }

  @media screen and (max-width: 768px) {
    .cf-footer {
      padding: 40px 20px 0 20px;
    }

    .cf-top-grid {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .cf-col-logo {
      padding-bottom: 30px;
    }

    .cf-col-logo .cf-logo img {
      margin: 0 auto;
    }

    .cf-col-logo .cf-description {
      text-align: center;
      max-width: 100%;
    }

    .cf-follow-row {
      justify-content: center;
    }

    .cf-nav-col {
      border-top: 1px solid rgba(255,255,255,0.15);
    }

    .cf-accordion-trigger {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: none;
      border: none;
      cursor: pointer;
      padding: 16px 0;
      text-align: left;
    }

    .cf-accordion-trigger .cf-nav-heading {
      margin: 0;
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.08em;
      color: {{ heading_color }};
      text-transform: uppercase;
      transition: color 0.2s;
    }

    .cf-accordion-trigger[aria-expanded="true"] .cf-nav-heading {
      color: {{ accordion_active_color }};
    }

    .cf-accordion-icon {
      width: 20px;
      height: 20px;
      position: relative;
      flex-shrink: 0;
    }

    .cf-accordion-icon::before,
    .cf-accordion-icon::after {
      content: '';
      position: absolute;
      background-color: {{ text_color }};
      transition: transform 0.3s, opacity 0.3s;
    }

    .cf-accordion-icon::before {
      width: 12px;
      height: 2px;
      top: 9px;
      left: 4px;
    }

    .cf-accordion-icon::after {
      width: 2px;
      height: 12px;
      top: 4px;
      left: 9px;
    }

    .cf-accordion-trigger[aria-expanded="true"] .cf-accordion-icon::after {
      transform: rotate(90deg);
      opacity: 0;
    }

    .cf-accordion-body {
      display: none;
      padding-bottom: 16px;
    }

    .cf-accordion-body.is-open {
      display: block;
    }

    .cf-nav-col .cf-nav-heading.desktop-heading {
      display: none;
    }

    .cf-mid-section {
      grid-template-columns: 1fr;
    }

    .cf-mid-right {
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .cf-mid-left {
      order: 2;
    }

    .cf-mid-right {
      order: 1;
    }
  }

  @media screen and (min-width: 769px) {
    .cf-accordion-trigger {
      display: none;
    }

    .cf-accordion-icon {
      display: none;
    }

    .cf-accordion-body {
      display: block !important;
    }
  }
</style>

<footer class="cf-footer" id="cf-footer-{{ section.id }}">
  <div class="cf-top-grid">
    <div class="cf-col-logo">
      <div class="cf-logo">
        {% if logo != blank %}
          <img src="{{ logo | image_url: width: logo_width }}" alt="{{ shop.name }}" width="{{ logo_width }}">
        {% else %}
          <span style="font-size: 22px; font-weight: 700; color: #D15327;">{{ shop.name }}</span>
        {% endif %}
      </div>
      {% if description != blank %}
        <p class="cf-description">{{ description }}</p>
      {% endif %}
      <div class="cf-follow-row">
        <span class="cf-follow-label">{{ follow_text }}</span>
        <div class="cf-social-icons">
          {% if facebook_url != blank %}
            <a href="{{ facebook_url }}" class="cf-social-icon" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
            </a>
          {% endif %}
          {% if instagram_url != blank %}
            <a href="{{ instagram_url }}" class="cf-social-icon" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" style="fill:{{ bg_color }};"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" stroke="{{ bg_color }}" stroke-width="2" stroke-linecap="round"/></svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="cf-nav-col">
      <span class="cf-nav-heading desktop-heading">{{ col2_heading }}</span>
      <button class="cf-accordion-trigger" aria-expanded="true" aria-controls="cf-acc-col2-{{ section.id }}">
        <span class="cf-nav-heading">{{ col2_heading }}</span>
        <span class="cf-accordion-icon" aria-hidden="true"></span>
      </button>
      <div class="cf-accordion-body is-open" id="cf-acc-col2-{{ section.id }}">
        {% if col2_menu != blank %}
          {% assign col2_linklists = linklists[col2_menu] %}
          {% if col2_linklists != blank %}
            <ul>
              {% for link in col2_linklists.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="cf-nav-col">
      <span class="cf-nav-heading desktop-heading">{{ col3_heading }}</span>
      <button class="cf-accordion-trigger" aria-expanded="false" aria-controls="cf-acc-col3-{{ section.id }}">
        <span class="cf-nav-heading">{{ col3_heading }}</span>
        <span class="cf-accordion-icon" aria-hidden="true"></span>
      </button>
      <div class="cf-accordion-body" id="cf-acc-col3-{{ section.id }}">
        {% if col3_menu != blank %}
          {% assign col3_linklists = linklists[col3_menu] %}
          {% if col3_linklists != blank %}
            <ul>
              {% for link in col3_linklists.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="cf-nav-col">
      <span class="cf-nav-heading desktop-heading">{{ col4_heading }}</span>
      <button class="cf-accordion-trigger" aria-expanded="false" aria-controls="cf-acc-col4-{{ section.id }}">
        <span class="cf-nav-heading">{{ col4_heading }}</span>
        <span class="cf-accordion-icon" aria-hidden="true"></span>
      </button>
      <div class="cf-accordion-body" id="cf-acc-col4-{{ section.id }}">
        {% if col4_menu != blank %}
          {% assign col4_linklists = linklists[col4_menu] %}
          {% if col4_linklists != blank %}
            <ul>
              {% for link in col4_linklists.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="cf-nav-col">
      <span class="cf-nav-heading desktop-heading">{{ col5_heading }}</span>
      <button class="cf-accordion-trigger" aria-expanded="false" aria-controls="cf-acc-col5-{{ section.id }}">
        <span class="cf-nav-heading">{{ col5_heading }}</span>
        <span class="cf-accordion-icon" aria-hidden="true"></span>
      </button>
      <div class="cf-accordion-body" id="cf-acc-col5-{{ section.id }}">
        {% if col5_menu != blank %}
          {% assign col5_linklists = linklists[col5_menu] %}
          {% if col5_linklists != blank %}
            <ul>
              {% for link in col5_linklists.links %}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>

  <hr class="cf-divider">

  <div class="cf-mid-section">
    <div class="cf-mid-left">
      <span class="cf-payment-label">{{ payment_label }}</span>
      {% if show_payment_icons %}
        <div class="cf-payment-icons">
         
