{% schema %}
{
  "name": "Hero Split Banner",
  "tag": "section",
  "class": "hsb-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Content Padding Top",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "first_col_width",
      "label": "First Column Width",
      "default": "50",
      "options": [
        { "value": "35", "label": "35%" },
        { "value": "40", "label": "40%" },
        { "value": "45", "label": "45%" },
        { "value": "50", "label": "50%" },
        { "value": "55", "label": "55%" },
        { "value": "60", "label": "60%" },
        { "value": "65", "label": "65%" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_product_cards",
      "label": "Show Product Cards",
      "default": true
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "color",
      "id": "bg_fallback",
      "label": "Background Fallback Color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "bg_position",
      "label": "Background Position",
      "default": "center center",
      "options": [
        { "value": "top left", "label": "Top Left" },
        { "value": "top center", "label": "Top Center" },
        { "value": "top right", "label": "Top Right" },
        { "value": "center left", "label": "Center Left" },
        { "value": "center center", "label": "Center" },
        { "value": "center right", "label": "Center Right" },
        { "value": "bottom left", "label": "Bottom Left" },
        { "value": "bottom center", "label": "Bottom Center" },
        { "value": "bottom right", "label": "Bottom Right" }
      ]
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>NOT SURE WHICH KIT FITS? WE'LL MATCH IT FOR YOU.</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Tell us your sport, your size, and your budget. We'll put together a complete matching kit from brands you actually want to wear."
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Button 1"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "FIND THE PERFECT KIT"
    },
    {
      "type": "url",
      "id": "btn1_url",
      "label": "Button 1 URL"
    },
    {
      "type": "color",
      "id": "btn1_bg",
      "label": "Button 1 Background",
      "default": "#D15327"
    },
    {
      "type": "color",
      "id": "btn1_text",
      "label": "Button 1 Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button 2"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label",
      "default": "BROWSE CAMSO DEALS"
    },
    {
      "type": "url",
      "id": "btn2_url",
      "label": "Button 2 URL"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Button 2 Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn2_border",
      "label": "Button 2 Border Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn2_text",
      "label": "Button 2 Text Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Product Card 1"
    },
    {
      "type": "image_picker",
      "id": "p1_image",
      "label": "Product 1 Image"
    },
    {
      "type": "text",
      "id": "p1_title",
      "label": "Product 1 Title",
      "default": "Camso 4S1 UTV Track System"
    },
    {
      "type": "url",
      "id": "p1_url",
      "label": "Product 1 URL"
    },
    {
      "type": "text",
      "id": "p1_review_score",
      "label": "Product 1 Review Score",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "p1_review_count",
      "label": "Product 1 Review Count",
      "default": "37"
    },
    {
      "type": "text",
      "id": "p1_price",
      "label": "Product 1 Price",
      "default": "$6,599"
    },
    {
      "type": "header",
      "content": "Product Card 2"
    },
    {
      "type": "image_picker",
      "id": "p2_image",
      "label": "Product 2 Image"
    },
    {
      "type": "text",
      "id": "p2_title",
      "label": "Product 2 Title",
      "default": "Camso X4S ATV/UTV Track Kit"
    },
    {
      "type": "url",
      "id": "p2_url",
      "label": "Product 2 URL"
    },
    {
      "type": "text",
      "id": "p2_review_score",
      "label": "Product 2 Review Score",
      "default": "5.0"
    },
    {
      "type": "text",
      "id": "p2_review_count",
      "label": "Product 2 Review Count",
      "default": "37"
    },
    {
      "type": "text",
      "id": "p2_price",
      "label": "Product 2 Price",
      "default": "$5,049"
    }
  ],
  "presets": [
    {
      "name": "Hero Split Banner"
    }
  ]
}
{% endschema %}

<style>
  .hsb-section {
    position: relative;
    overflow: hidden;
    background-color: var(--hsb-bg-fallback, #111111);
    padding-bottom: var(--hsb-padding-bottom, 40px);
  }

  .hsb-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: var(--hsb-bg-position, center center);
    background-image: var(--hsb-bg-image, none);
    z-index: 0;
  }

  .hsb-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--hsb-overlay-color, #000000);
    opacity: var(--hsb-overlay-opacity, 0.4);
    z-index: 1;
  }

  .hsb-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: stretch;
    max-width: 100%;
  }

  .hsb-col-left {
    width: var(--hsb-col-width, 50%);
    padding: var(--hsb-padding-top, 60px) 40px 40px 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .hsb-col-right {
    width: calc(100% - var(--hsb-col-width, 50%));
    box-sizing: border-box;
  }

  .hsb-heading {
    font-size: 40px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--hsb-heading-color, #ffffff);
    margin: 0 0 16px;
    text-transform: uppercase;

font-family: Goldman;
  }

  .hsb-heading p {
    margin: 0;
  }

  .hsb-description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--hsb-desc-color, #cccccc);
    margin: 0 0 28px;
    max-width: 480px;
  }

  .hsb-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .hsb-btn {
    display: inline-block;
    padding: 13px 22px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .hsb-btn:hover {
    opacity: 0.85;
  }

  .hsb-btn-primary {
    background-color: var(--hsb-btn1-bg, #D15327);
    color: var(--hsb-btn1-text, #ffffff);
    border: 2px solid var(--hsb-btn1-bg, #D15327);
    font-family: Goldman;
  }

  .hsb-btn-secondary {
    background-color: var(--hsb-btn2-bg, transparent);
    color: var(--hsb-btn2-text, #ffffff);
    border: 2px solid var(--hsb-btn2-border, #ffffff);
    font-family: Goldman;
  }

  .hsb-cards {
    display: flex;
    flex-direction: row;
    gap: 10px;
    width: 100%;
  }

  .hsb-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border-radius: 6px;
    padding: 12px 14px;
    text-decoration: none;
    transition: background 0.2s ease;
    flex: 1;
    min-width: 0;
  }

  .hsb-card:hover {
    background: #f5f5f5;
  }

  .hsb-card-img-wrap {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border: 1.5px solid #D9DBDF;
    border-radius: 4px;
    overflow: hidden;
    background: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hsb-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hsb-card-img-placeholder {
    width: 100%;
    height: 100%;
    background: #eeeeee;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hsb-card-img-placeholder svg {
    opacity: 0.4;
  }

  .hsb-card-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .hsb-card-title {
    font-size: 12px;
    font-weight: 700;
    color: #111111;
    line-height: 1.3;
    white-space: normal;
  }

  .hsb-card-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .hsb-card-review-text {
    font-size: 10px;
    color: #777777;
  }

  .hsb-card-price {
    font-size: 15px;
    font-weight: 700;
    color: #D15327;
  }

  @media (max-width: 768px) {
    .hsb-inner {
      flex-direction: column;
    }

    .hsb-col-left {
      width: 100% !important;
      padding: var(--hsb-padding-top, 60px) 20px 32px 20px;
    }

    .hsb-col-right {
      width: 100% !important;
    }

    .hsb-heading {
      font-size: 28px;
    }

    .hsb-buttons {
      flex-direction: column;
    }

    .hsb-btn {
      text-align: center;
      width: 100%;
    }

    .hsb-cards {
      flex-direction: column;
    }
  }
</style>

{% assign overlay_decimal = section.settings.overlay_opacity | divided_by: 100.0 %}
{% assign col_width = section.settings.first_col_width | append: '%' %}

<section
  class="hsb-section"
  id="hsb-{{ section.id }}"
  style="
    --hsb-bg-fallback: {{ section.settings.bg_fallback }};
    --hsb-bg-position: {{ section.settings.bg_position }};
    --hsb-overlay-color: {{ section.settings.overlay_color }};
    --hsb-overlay-opacity: {{ overlay_decimal }};
    --hsb-padding-top: {{ section.settings.padding_top }}px;
    --hsb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hsb-col-width: {{ col_width }};
    --hsb-heading-color: {{ section.settings.heading_color }};
    --hsb-desc-color: {{ section.settings.description_color }};
    --hsb-btn1-bg: {{ section.settings.btn1_bg }};
    --hsb-btn1-text: {{ section.settings.btn1_text }};
    --hsb-btn2-bg: {{ section.settings.btn2_bg }};
    --hsb-btn2-border: {{ section.settings.btn2_border }};
    --hsb-btn2-text: {{ section.settings.btn2_text }};
  "
>
  {% if section.settings.bg_image != blank %}
    <div class="hsb-bg" style="background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');"></div>
  {% else %}
    <div class="hsb-bg"></div>
  {% endif %}
  <div class="hsb-overlay"></div>

  <div class="hsb-inner">
    <div class="hsb-col-left">
      {% if section.settings.heading != blank %}
        <div class="hsb-heading">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="hsb-description">{{ section.settings.description }}</p>
      {% endif %}

      <div class="hsb-buttons">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_url | default: '#' }}" class="hsb-btn hsb-btn-primary">{{ section.settings.btn1_label }}</a>
        {% endif %}
        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_url | default: '#' }}" class="hsb-btn hsb-btn-secondary">{{ section.settings.btn2_label }}</a>
        {% endif %}
      </div>

      {% if section.settings.show_product_cards %}
        <div class="hsb-cards">
          {% if section.settings.p1_title != blank %}
            <a href="{{ section.settings.p1_url | default: '#' }}" class="hsb-card">
              <div class="hsb-card-img-wrap">
                {% if section.settings.p1_image != blank %}
                  <img
                    src="{{ section.settings.p1_image | image_url: width: 144 }}"
                    alt="{{ section.settings.p1_title | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {% else %}
                  <div class="hsb-card-img-placeholder">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="3" y="3" width="18" height="18" rx="2" stroke="#999" stroke-width="1.5"/>
                      <circle cx="8.5" cy="8.5" r="1.5" fill="#999"/>
                      <path d="M3 15l5-5 4 4 3-3 6 6" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <div class="hsb-card-info">
                <div class="hsb-card-title">{{ section.settings.p1_title }}</div>
                <div class="hsb-card-stars">
                  <svg width="60" height="11" viewBox="0 0 85 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8.49993 12.8144L12.0196 14.9386C12.575 15.2737 13.2599 14.7757 13.1126 14.1446L12.1783 10.1404L15.2886 7.4459C15.7788 7.02161 15.5167 6.21623 14.8707 6.16169L10.7765 5.81461L9.17497 2.03565C8.92209 1.43994 8.07776 1.43994 7.82489 2.03565L6.22334 5.81461L2.12918 6.16169C1.48318 6.21623 1.22109 7.02161 1.71126 7.4459L4.82155 10.1404L3.88726 14.1446C3.73993 14.7757 4.42489 15.2737 4.98022 14.9386L8.49993 12.8144Z" fill="#EB891B"/>
