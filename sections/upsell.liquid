{% schema %}
  {
    "name": "Hero Split Banner",
    "tag": "section",
    "class": "hsb-section-wrapper",
    "settings": [
      {
        "type": "header",
        "content": "Layout"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Content Padding Top",
        "min": 0,
        "max": 300,
        "step": 4,
        "default": 60,
        "unit": "px"
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Section Padding Bottom",
        "min": 0,
        "max": 200,
        "step": 4,
        "default": 40,
        "unit": "px"
      },
      {
        "type": "select",
        "id": "first_col_width",
        "label": "First Column Width",
        "default": "50",
        "options": [
          {
            "value": "35",
            "label": "35%"
          },
          {
            "value": "40",
            "label": "40%"
          },
          {
            "value": "45",
            "label": "45%"
          },
          {
            "value": "50",
            "label": "50%"
          }, {
            "value": "55",
            "label": "55%"
          }, {
            "value": "60",
            "label": "60%"
          }, {
            "value": "65",
            "label": "65%"
          }
        ]
      }, {
        "type": "checkbox",
        "id": "show_product_cards",
        "label": "Show Product Cards",
        "default": true
      }, {
        "type": "header",
        "content": "Background"
      }, {
        "type": "image_picker",
        "id": "bg_image",
        "label": "Background Image"
      }, {
        "type": "color",
        "id": "bg_fallback",
        "label": "Background Fallback Color",
        "default": "#111111"
      }, {
        "type": "select",
        "id": "bg_position",
        "label": "Background Position",
        "default": "center center",
        "options": [
          {
            "value": "top left",
            "label": "Top Left"
          },
          {
            "value": "top center",
            "label": "Top Center"
          },
          {
            "value": "top right",
            "label": "Top Right"
          },
          {
            "value": "center left",
            "label": "Center Left"
          }, {
            "value": "center center",
            "label": "Center"
          }, {
            "value": "center right",
            "label": "Center Right"
          }, {
            "value": "bottom left",
            "label": "Bottom Left"
          }, {
            "value": "bottom center",
            "label": "Bottom Center"
          }, {
            "value": "bottom right",
            "label": "Bottom Right"
          }
        ]
      }, {
        "type": "range",
        "id": "overlay_opacity",
        "label": "Overlay Opacity",
        "min": 0,
        "max": 100,
        "step": 5,
        "default": 40,
        "unit": "%"
      }, {
        "type": "color",
        "id": "overlay_color",
        "label": "Overlay Color",
        "default": "#000000"
      }, {
        "type": "header",
        "content": "Content"
      }, {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>NOT SURE WHICH KIT FITS? WE'LL MATCH IT FOR YOU.</p>"
      }, {
        "type": "color",
        "id": "heading_color",
        "label": "Heading Color",
        "default": "#ffffff"
      }, {
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "Tell us your sport, your size, and your budget. We'll put together a complete matching kit from brands you actually want to wear."
      }, {
        "type": "color",
        "id": "description_color",
        "label": "Description Color",
        "default": "#cccccc"
      }, {
        "type": "header",
        "content": "Button 1"
      }, {
        "type": "text",
        "id": "btn1_label",
        "label": "Button 1 Label",
        "default": "FIND THE PERFECT KIT"
      }, {
        "type": "url",
        "id": "btn1_url",
        "label": "Button 1 URL"
      }, {
        "type": "color",
        "id": "btn1_bg",
        "label": "Button 1 Background",
        "default": "#D15327"
      }, {
        "type": "color",
        "id": "btn1_text",
        "label": "Button 1 Text Color",
        "default": "#ffffff"
      }, {
        "type": "header",
        "content": "Button 2"
      }, {
        "type": "text",
        "id": "btn2_label",
        "label": "Button 2 Label",
        "default": "BROWSE CAMSO DEALS"
      }, {
        "type": "url",
        "id": "btn2_url",
        "label": "Button 2 URL"
      }, {
        "type": "color",
        "id": "btn2_bg",
        "label": "Button 2 Background Color",
        "default": "#000000"
      }, {
        "type": "color",
        "id": "btn2_border",
        "label": "Button 2 Border Color",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "btn2_text",
        "label": "Button 2 Text Color",
        "default": "#ffffff"
      }, {
        "type": "header",
        "content": "Product Cards"
      }, {
        "type": "product",
        "id": "p1_product",
        "label": "Product 1",
        "info": "Title, image, price, link, and reviews come from this product."
      }, {
        "type": "product",
        "id": "p2_product",
        "label": "Product 2",
        "info": "Title, image, price, link, and reviews come from this product."
      }
    ],
    "presets": [
      {
        "name": "Hero Split Banner"
      }
    ]
  }
{% endschema %}

<style>
  .hsb-section {
    position: relative;
    overflow: hidden;
    background-color: var(--hsb-bg-fallback, #111111);
    padding-bottom: var(--hsb-padding-bottom, 40px);
  }

  .hsb-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: var(--hsb-bg-position, center center);
    background-image: var(--hsb-bg-image, none);
    z-index: 0;
  }

  .hsb-overlay {
    position: absolute;
    inset: 0;
    background-color: var(--hsb-overlay-color, #000000);
    opacity: var(--hsb-overlay-opacity, 0.4);
    z-index: 1;
  }

  .hsb-inner {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: stretch;
    max-width: 100%;
  }

  .hsb-col-left {
    width: var(--hsb-col-width, 50%);
    padding: var(--hsb-padding-top, 60px) 40px 40px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    box-sizing: border-box;
  }

  .hsb-col-right {
    width: calc(100% - var(--hsb-col-width, 50%));
    box-sizing: border-box;
  }

  .hsb-heading {
    font-size: 40px;
    font-weight: 900;
    line-height: 1.1;
    color: var(--hsb-heading-color, #ffffff);
    margin: 0 0 16px;
    text-transform: uppercase;

    font-family: Goldman;
  }

  .hsb-heading p {
    margin: 0;
  }

  .hsb-description {
    font-size: 15px;
    line-height: 1.6;
    color: var(--hsb-desc-color, #cccccc);
    margin: 0 0 28px;
    max-width: 480px;
  }

  .hsb-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .hsb-btn {
    display: inline-block;
    padding: 13px 22px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    box-sizing: border-box;
  }

  .hsb-btn:hover {
    opacity: 0.85;
  }

  .hsb-btn-primary {
    background-color: var(--hsb-btn1-bg, #D15327);
    color: var(--hsb-btn1-text, #ffffff);
    border: 2px solid var(--hsb-btn1-bg, #D15327);
    font-family: Goldman;
  }

  .hsb-btn-secondary {
    background-color: var(--hsb-btn2-bg, transparent);
    color: var(--hsb-btn2-text, #ffffff);
    border: 2px solid var(--hsb-btn2-border, #ffffff);
    font-family: Goldman;
  }

  .hsb-cards {
    display: flex;
    flex-direction: row;
    gap: 10px;
    width: 100%;
  }

  .hsb-card {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border-radius: 6px;
    padding: 12px 14px;
    text-decoration: none;
    transition: background 0.2s ease;
    flex: 1;
    min-width: 0;
  }

  .hsb-card:hover {
    background: #f5f5f5;
  }

  .hsb-card-img-wrap {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border: 1.5px solid #D9DBDF;
    border-radius: 4px;
    overflow: hidden;
    background: #f7f7f7;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hsb-card-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .hsb-card-stars .rating {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .hsb-card-stars .rating__stars {
    display: flex;
    gap: 1px;
  }

  .hsb-card-stars .rating__star {
    width: 11px;
    height: 11px;
  }

  .hsb-card-stars .rating__caption {
    font-size: 10px;
    color: #666666;
    white-space: nowrap;
  }

  .hsb-card-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .hsb-card-title {
    font-size: 12px;
    font-weight: 700;
    color: #111111;
    line-height: 1.3;
    white-space: normal;
  }

  .hsb-card-stars {
    display: flex;
    align-items: center;
    gap: 4px;
    flex-wrap: wrap;
  }

  .hsb-card-price {
    font-size: 15px;
    font-weight: 700;
    color: #D15327;
  }

  @media (max-width: 768px) {
    .hsb-inner {
      flex-direction: column;
    }

    .hsb-col-left {
      width: 100% !important;
      padding: var(--hsb-padding-top, 60px) 20px 32px;
    }

    .hsb-col-right {
      width: 100% !important;
    }

    .hsb-heading {
      font-size: 28px;
    }

    .hsb-buttons {
      flex-direction: column;
    }

    .hsb-btn {
      text-align: center;
      width: 100%;
    }

    .hsb-cards {
      flex-direction: column;
    }
  }
</style>

{% assign overlay_decimal = section.settings.overlay_opacity | divided_by: 100.0 %}
{% assign col_width = section.settings.first_col_width | append: '%' %}

<section
  class="hsb-section"
  id="hsb-{{ section.id }}"
  style="
    --hsb-bg-fallback: {{ section.settings.bg_fallback }};
    --hsb-bg-position: {{ section.settings.bg_position }};
    --hsb-overlay-color: {{ section.settings.overlay_color }};
    --hsb-overlay-opacity: {{ overlay_decimal }};
    --hsb-padding-top: {{ section.settings.padding_top }}px;
    --hsb-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hsb-col-width: {{ col_width }};
    --hsb-heading-color: {{ section.settings.heading_color }};
    --hsb-desc-color: {{ section.settings.description_color }};
    --hsb-btn1-bg: {{ section.settings.btn1_bg }};
    --hsb-btn1-text: {{ section.settings.btn1_text }};
    --hsb-btn2-bg: {{ section.settings.btn2_bg }};
    --hsb-btn2-border: {{ section.settings.btn2_border }};
    --hsb-btn2-text: {{ section.settings.btn2_text }};
  ">
  {% if section.settings.bg_image != blank %}
    <div class="hsb-bg" style="background-image: url('{{ section.settings.bg_image | image_url: width: 1920 }}');"></div>
  {% else %}
    <div class="hsb-bg"></div>
  {% endif %}
  <div class="hsb-overlay"></div>

  <div class="hsb-inner">
    <div class="hsb-col-left">
      {% if section.settings.heading != blank %}
        <div class="hsb-heading">{{ section.settings.heading }}</div>
      {% endif %}

      {% if section.settings.description != blank %}
        <p class="hsb-description">{{ section.settings.description }}</p>
      {% endif %}

      <div class="hsb-buttons">
        {% if section.settings.btn1_label != blank %}
          <a href="{{ section.settings.btn1_url | default: '#' }}" class="hsb-btn hsb-btn-primary">{{ section.settings.btn1_label }}</a>
        {% endif %}
        {% if section.settings.btn2_label != blank %}
          <a href="{{ section.settings.btn2_url | default: '#' }}" class="hsb-btn hsb-btn-secondary">{{ section.settings.btn2_label }}</a>
        {% endif %}
      </div>

      {% if section.settings.show_product_cards %}
        <div class="hsb-cards">
          {% for card_index in (1..2) %}
            {% if card_index == 1 %}
              {% assign card_product = section.settings.p1_product %}
            {% else %}
              {% assign card_product = section.settings.p2_product %}
            {% endif %}
            {% if card_product != blank and card_product.url == blank %}
              {% assign card_product = all_products[card_product] %}
            {% endif %}

            {% if card_product != blank and card_product.url != blank %}
              {% assign card_rating = card_product.metafields.reviews.rating.value %}
              {% assign card_rating_count = card_product.metafields.reviews.rating_count.value | default: 0 | plus: 0 %}

              <a href="{{ card_product.url }}" class="hsb-card">
                {% if card_product.featured_image != blank %}
                  <div class="hsb-card-img-wrap">
                    <img
                      src="{{ card_product.featured_image | image_url: width: 144 }}"
                      alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
                      width="64"
                      height="64"
                      loading="lazy">
                  </div>
                {% endif %}
                <div class="hsb-card-info">
                  <div class="hsb-card-title">{{ card_product.title | escape }}</div>
                  {% if card_rating != blank and card_rating_count > 0 %}
                    <div class="hsb-card-stars">
                      {% render 'product-rating'
                        , product: card_product %}
                    </div>
                  {% endif %}
                  <div class="hsb-card-price">{{ card_product.price | money }}</div>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="hsb-col-right"></div>
  </div>
</section>