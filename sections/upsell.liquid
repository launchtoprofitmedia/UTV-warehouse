                    <path d="M76.5 12.8144L80.0197 14.9386C80.5751 15.2737 81.26 14.7757 81.1127 14.1446L80.1784 10.1404L83.2887 7.4459C83.7789 7.02161 83.5168 6.21623 82.8708 6.16169L78.7766 5.81461L77.1751 2.03565C76.9222 1.43994 76.0779 1.43994 75.825 2.03565L74.2235 5.81461L70.1293 6.16169C69.4833 6.21623 69.2212 7.02161 69.7114 7.4459L72.8217 10.1404L71.8874 14.1446C71.74 14.7757 72.425 15.2737 72.9803 14.9386L76.5 12.8144Z" fill="#EB891B"/>
                  </svg>
                  <span class="hsb-card-review-text">{{ section.settings.p1_review_score }}/5.0 ({{ section.settings.p1_review_count }} reviews)</span>
                </div>
                <div class="hsb-card-price">{{ section.settings.p1_price }}</div>
              </div>
            </a>
          {% endif %}

          {% if section.settings.p2_title != blank %}
            <a href="{{ section.settings.p2_url | default: '#' }}" class="hsb-card">
              <div class="hsb-card-img-wrap">
                {% if section.settings.p2_image != blank %}
                  <img
                    src="{{ section.settings.p2_image | image_url: width: 144 }}"
                    alt="{{ section.settings.p2_title | escape }}"
                    width="64"
                    height="64"
                    loading="lazy"
                  >
                {% else %}
                  <div class="hsb-card-img-placeholder">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <rect x="3" y="3" width="18" height="18" rx="2" stroke="#999" stroke-width="1.5"/>
                      <circle cx="8.5" cy="8.5" r="1.5" fill="#999"/>
                      <path d="M3 15l5-5 4 4 3-3 6 6" stroke="#999" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
